Private Sub DibujarEscalaColor()

    Dim a As Integer, g As Integer

    'genero la escala

    For a = 0 To 250
        ColorScale[0, a] = 1
        ColorScale[1, a] = a / 250
    Next

    For a = 0 To 250
        ColorScale[0, a + 250] = 1 - a / 250
        ColorScale[1, a + 250] = 1

    Next
    For a = 0 To 250
        ColorScale[2, a + 500] = a / 250
        ColorScale[1, a + 500] = 1

    Next
    For a = 0 To 250
        ColorScale[2, a + 750] = 1
        ColorScale[1, a + 750] = 1 - a / 250
    Next

    gl.MatrixMode(gl.PROJECTION)
    gl.PushMatrix

    gl.LoadIdentity()

    Gl.Ortho(0, fmain.gestru.w, 0, fmain.gestru.h, 0, 1)

    gl.MatrixMode(gl.MODELVIEW)
    gl.PushMatrix
    gl.LoadIdentity()

    gl.Begin(gl.lines)
    For a = 0 To 300

        gl.Color3f(ColorScale[0, a * 1000 / 300], ColorScale[1, a * 1000 / 300], ColorScale[2, a * 1000 / 300])
        gl.Vertex2i(20, 100 + a)
        gl.Vertex2i(30, 100 + a)
    Next

    gl.End
    gl.PopMatrix
    gl.MatrixMode(gl.PROJECTION)
    gl.PopMatrix

End

Private Sub GenerarGridLosa(losa As Integer, esfuerzo As Integer, Optional interpolado As Integer = 2)

    Dim GridCoord As New Float[]  'las coordenadas XYZ de los puntos de la grilla
    Dim GridEsf As New Float[]  'el esfuerzo a representar
    Dim P00 As New Punto3d, Pff As New Punto3d  'los limites XYZ de la grilla
    Dim dX As Float, dY As Float, dZ As Float  'las distancias entre puntos de la grilla
    Dim sX As Integer, sZ As Integer  ' los pasos en la grilla
    Dim x As Integer, z As Integer ' variables auxiliares para los for-next

    Dim n1 As Integer, n2 As Integer, n3 As Integer, n4 As Integer 'nudos limite

    Dim p As Integer  'la posicion en el array

    GridCoord.Resize((e3d.model.losas[losa].nxGrid + 1) * (e3d.model.losas[losa].nxGrid + 1) * 3)

    GridEsf.Resize((e3d.model.losas[losa].nxGrid + 1) * (e3d.model.losas[losa].nxGrid + 1))

    'genero la grid de puntos XYZ
    n1 = e3d.model.losas[losa].Nudo1
    n2 = e3d.model.losas[losa].Nudo2
    n3 = e3d.model.losas[losa].Nudo3
    n4 = e3d.model.losas[losa].Nudo4

    dx = e3d.model.nudo[n2].x - e3d.model.nudo[n1].x

    dy = e3d.model.nudo[n4].x - e3d.model.nudo[n1].x

    dz = e3d.model.nudo[n4].x - e3d.model.nudo[n3].x

    For z = 0 To e3d.model.losas[losa].nzGrid
        For x = 0 To e3d.model.losas[losa].nxGrid
            p = (z * e3d.model.losas[losa].nXGrid + x) * 3

            GridCoord[p] = e3d.model.nudo[n1].x + dx * x
            GridCoord[p + 1] = e3d.model.nudo[n1].y + dy * x
            GridCoord[p + 1] = e3d.model.nudo[n1].z + dz * z

        Next
    Next

    'genero la grid de esfuerzos

    For z = 1 To e3d.model.losas[losa].nzGrid
        For x = 1 To e3d.model.losas[losa].nxGrid

            'ahora tengo que buscar la model.barra que necesito para ver el esf

            p = z * e3d.model.losas[losa].nXGrid + x

            GridEsf[p] = Rnd(0, 1000)

        Next
    Next

    'la dibujo por triangulos

    'glx.BeginVBO(ListaLosas)

    For z = 0 To e3d.model.losas[losa].nzGrid
        For x = 0 To e3d.model.losas[losa].nxGrid

            'ahora tengo que buscar la model.barra que necesito para ver el esf

            p = z * e3d.model.losas[losa].nXGrid + x

            GridEsf[p] = Rnd(0, 1000)

        Next
    Next

End

Private Sub DibujarEsfuerzosLosas(direccion As Integer, Esfuerzo As Integer)

    'direccion 1 = X, 2 = Z, 3 = X+Z (vectorial)

    Dim a As Integer, bru As PaintBrush, eje As New Punto3d, l As ClsLosa, b As Integer, d As Integer, c As Integer
    Dim centro As New Punto3d
    Dim p1 As New Punto3d, p2 As New Punto3d, p3 As New Punto3d, p4 As New Punto3d, pm As New Punto3d

    Dim c1, c2, c3, c4, cm As New GLColorSt

    Dim radio As Float

    ' nuevos
    Dim dX12 As Float, dX34 As Float, dZ13 As Float, dZ24 As Float, dY12 As Float, dY13 As Float

    Dim pX As Integer, pZ As Integer

    Dim c1s As String, c2s As String, c3s As String, c4s As String
    Dim x0 As Float, z0 As Float, x As Float, z As Float, y0 As Float, y1 As Float, y As Float

    Dim maxEscala As Float
    Dim vEsf, vProm As Float

    If Not ((e3d.model.graficos.FiltroTipo = e3d.tipo_indef) Or (e3d.model.graficos.FiltroTipo = e3d.tipo_losa)) Then Return
    If e3d.model.graficos.SeDibujanSubElementos Then Return         ' No vamos a superponer escala color con escala de diagrama
    For Each l In e3d.model.losas
        If ((e3d.model.graficos.FiltroSector <= 0) Or (e3d.model.graficos.FiltroSector = l.sector)) Then

            If esfuerzo = 1 Then maxEscala = e3d.model.graficos.maxNLosas
            If esfuerzo = 2 Then maxEscala = e3d.model.graficos.maxQyLosas
            If esfuerzo = 3 Then maxEscala = e3d.model.graficos.maxQzLosas
            If esfuerzo = 4 Then maxEscala = e3d.model.graficos.maxTLosas
            If esfuerzo = 5 Then maxEscala = e3d.model.graficos.maxMyLosas
            If esfuerzo = 6 Then maxEscala = e3d.model.graficos.maxMzLosas

            ' creo la grilla

            For a = 1 To l.nzGrid  ' cuadrados en direccion Z

                For b = 1 To l.nxGrid 'c  ' cuadrados en la direccion X

                    '1

                    e3d.GridLosas3D(l, b - 1, a - 1, p1)

                    vEsf = e3d.EsfSecLosas(l, b - 1, a - 1, direccion, esfuerzo)
                    vProm += vEsf
                    '
                    ScaleColorRGB(vEsf, maxEscala,, 10, c1)

                    '2

                    e3d.GridLosas3D(l, b, a - 1, p2)
                    vEsf = e3d.EsfSecLosas(l, b, a - 1, direccion, esfuerzo)
                    vProm += vEsf
                    ScaleColorRGB(vesf, maxEscala,, 10, c2)

                    '4
                    e3d.GridLosas3D(l, b, a, P4)
                    vesf = e3d.EsfSecLosas(l, b, a, direccion, esfuerzo)
                    vProm += vEsf
                    ScaleColorRGB(vesf, maxEscala,, 10, c4)

                    '3
                    e3d.GridLosas3D(l, b - 1, a, P3)
                    vEsf = e3d.EsfSecLosas(l, b - 1, a, direccion, esfuerzo)
                    vProm += vEsf
                    ScaleColorRGB(vesf, maxEscala,, 10, c3)

                    ' Ahora genero el Quad Coloreado

                    pm.x = (p1.x + p2.x) / 2
                    pm.y = p1.y
                    pm.z = (p1.z + p3.z) / 2
                    vProm /= 4
                    ScaleColorRGB(vProm, maxEscala,, 10, cm)

                    GLTriangle4F(p1, p2, pm, c1, c2, cm)
                    GLTriangle4F(p2, p4, pm, c2, c4, cm)
                    GLTriangle4F(p3, p4, pm, c3, c4, cm)
                    GLTriangle4F(p1, p3, pm, c1, c3, cm)

                    vProm = 0
                    'GLQuadColor4F(p1, p2, p4, p3, c1, c2, c4, c3)

                Next

            Next

        End If
    Next

End

Public Sub GLTriangle4F(p1 As Punto3d, p2 As Punto3d, p3 As Punto3d, Optional c1 As GLColorSt, c2 As GLColorSt, c3 As GLColorSt, normal As Punto3d)

    ' Quad esta obsoleto , reemplazo por dos triangulos

    gl.begin(gl.TRIANGLES)

    Vertex3D(p1, c1)
    Vertex3D(p2, c2)
    Vertex3D(p3, c3)
    gl.End

End

Public Sub GLQuadColor4F(p1 As Punto3d, p2 As Punto3d, p3 As Punto3d, p4 As Punto3d, Optional c1 As GLColorSt, c2 As GLColorSt, c3 As GLColorSt, c4 As GLColorSt, normal As Punto3d)

    ' Quad esta obsoleto , reemplazo por dos triangulos

    gl.begin(gl.TRIANGLES)

    Vertex3D(p1, c1)
    Vertex3D(p2, c2)
    Vertex3D(p3, c3)
    gl.End

    gl.begin(gl.TRIANGLEs)
    Vertex3D(p1, c1)
    Vertex3D(p3, c3)
    Vertex3D(p4, c4)

    gl.end

End

Private Sub glColor4f(r As Float, g As Float, b As Float, Optional Alpha As Float = 1)

    gl.Color4f(r, g, b, Alpha)
    ' ademas lo guardo

    glcolor4fcurrent.r = r
    glcolor4fcurrent.g = g
    glcolor4fcurrent.b = b
    glcolor4fcurrent.Alpha = Alpha

End

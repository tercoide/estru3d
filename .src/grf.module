Private Sub Copy3D(Destino As Punto3d, Origen As Punto3d)
    ' copia el punto 3D

    Destino.x = Origen.x
    Destino.y = Origen.y
    Destino.z = Origen.z

End

Private Sub GetCG()

    'determina el centro de gravedad de una coleccion de puntos 3d
    ' copia el punto 3D
    Dim p As Integer '´ e3d.model.nudotype4

    If e3d.model.nudo.Count = 0 Then Return
    mundocg.x = 0
    mundocg.y = 0
    mundocg.z = 0

    For Each n As ClsNudo In e3d.model.nudo
        mundocg.x += n.x
        mundocg.y += n.y
        mundocg.z += n.z

    Next
    '
    mundoCG.x /= e3d.model.nudo.Count
    mundoCG.y /= e3d.model.nudo.Count
    mundocg.z /= e3d.model.nudo.Count

    cgX = mundocg.x
    cgY = mundocg.Y
    cgZ = mundocg.z

    'ademas envio a C

    'modLibMatrix8.setCG(cgx, cgy, cgz)

End

Private Sub DibujarLosas()

    Dim a As Integer, bru As PaintBrush, pr2 As New Punto3d, pr1 As New Punto3d, pr3 As New Punto3d, pr4 As New Punto3d
    Dim l As ClsLosa, t As ClsTabique

    glx.BeginVBO(VboLosas)

    glcolorRGB(Color.LightGray, 0.55)
    '

    For Each l In e3d.model.losas

        If (e3d.model.graficos.FiltroSector <= 0) Or (l.sector = e3d.model.graficos.FiltroSector) Then

            GLQuadColor4f(e3d.model.nudo[l.Nudo1].xyz, e3d.model.nudo[l.Nudo2].xyz, e3d.model.nudo[l.Nudo4].xyz, e3d.model.nudo[l.Nudo3].xyz)

        End If

    Next

    For Each t In e3d.model.tabiques

        If e3d.model.graficos.FiltroSector > 0 And t.sector = e3d.model.graficos.FiltroSector Then

            GLQuadColor4f(e3d.model.nudo[t.Nudo1], e3d.model.nudo[t.Nudo2], e3d.model.nudo[t.Nudo4], e3d.model.nudo[t.Nudo3])

        End If
    Next
    glx.EndVBO()

End

Private Sub dibujar_numero_losas()

    Dim a As Integer, bru As PaintBrush, eje As New Punto3d
    Dim centro As New Punto3d
    Dim p1 As New Punto3d
    Dim p2 As New Punto3d
    Dim p3 As New Punto3d
    Dim p4 As New Punto3d

    Dim radio As Float
    Dim l As ClsLosa

    For Each l In e3d.model.losas
        If ((e3d.model.graficos.FiltroSector <= 0) Or (e3d.model.graficos.FiltroSector = l.sector)) Then

            p1.x = e3d.model.nudo[l.Nudo1].x
            p1.y = e3d.model.nudo[l.Nudo1].y
            p1.z = e3d.model.nudo[l.Nudo1].z

            p2.x = e3d.model.nudo[l.Nudo2].x
            p2.y = e3d.model.nudo[l.Nudo2].y
            p2.z = e3d.model.nudo[l.Nudo2].z

            p3.x = e3d.model.nudo[l.Nudo3].x
            p3.y = e3d.model.nudo[l.Nudo3].y
            p3.z = e3d.model.nudo[l.Nudo3].z

            p4.x = e3d.model.nudo[l.Nudo4].x
            p4.y = e3d.model.nudo[l.Nudo4].y
            p4.z = e3d.model.nudo[l.Nudo4].z

            centro.x = (p4.x + p1.x) / 2
            centro.y = (p4.y + p1.y) / 2
            centro.z = (p4.z + p1.z) / 2

            radio = modAlgebra.Distancia(p1, centro) / 8

            ' necesito el eje del circulo
            ' para ello obtengo el producto Cross

            p1.x = centro.x - p1.x
            p1.y = centro.y - p1.y
            p1.z = centro.z - p1.z

            p3.x = centro.x - e3d.model.nudo[l.Nudo3].x
            p3.y = centro.y - e3d.model.nudo[l.Nudo3].y
            p3.z = centro.z - e3d.model.nudo[l.Nudo3].z

            modAlgebra.Cross(p1, p3, eje)

            eje.x += centro.x
            eje.y += centro.Y
            eje.z += centro.z

            circulo(centro, eje, radio, Color.Black, False)

            glx.DrawText3D(Format$(l.numero, "0") & "-" & Format$(l.sector, "0"), centro, 12, Color.DarkBlue,, 2, 2)

        End If
    Next

End

'' Carga basic.vert/frag la primera vez (hace falta el contexto activo) y lo activa
Private Sub UsarShader()

    If $iShader = 0 Then
        $iShader = glx.LoadShader(Application.Path &/ ".hidden/shaders/basic.vert", Application.Path &/ ".hidden/shaders/basic.frag")
        If $iShader = 0 Then
            $iShader = -1
            AppLog.Warning("No compilo el shader basico, se dibuja sin shaders", "grf.UsarShader")
        Endif
    Endif
    glx.Matrices.BindProgram($iShader)

End

'' Deja las matrices de la camara en el pipeline fijo, para lo que todavia se dibuja sin VBO
Private Sub MatricesFijas()

    glx.Matrices.BindProgram(0)
    glx.LoadFixedMatrices(fmain.glCam.projMatrix, fmain.glCam.modelMatrix)

End

'' Mira el centro de la estructura desde la distancia en que entra, sin cambiar la direccion
Public Sub EncuadrarCamara()

    fmain.glCam.Target.x = cgx
    fmain.glCam.Target.y = cgy
    fmain.glCam.Target.z = cgz
    fmain.glCam.Distance = Max(2 * maxmax, fmain.glCam.MinDistance)
    fmain.glCam.UpdateFromOrbit()

End

'' Los colores de picking: una linea por barra visible y un punto por nudo
Private Sub DibujarPick()

    Dim b As ClsBarra
    Dim n As ClsNudo
    Dim p1, p2 As Punto3d

    fmain.Picker.ResetIndex()
    fmain.objHovered = Null

    glx.BeginVBO(VboPickBarras)
    For Each b In e3d.model.barra
        If Not b.Visible Then Continue
        p1 = e3d.model.nudo[b.ni].xyz
        p2 = e3d.model.nudo[b.nF].xyz
        glx.DrawLines3D([p1.x, p1.y, p1.z, p2.x, p2.y, p2.z], Color.Black, 1)
        VboPickBarras.TagPick(fmain.Picker.Register(b))
    Next
    glx.EndVBO()

    glx.BeginVBO(VboPickNudos)
    For Each n In e3d.model.nudo
        glx.Drawpoints3D([n.x, n.y, n.z], Color.Black, 1)
        VboPickNudos.TagPick(fmain.Picker.Register(n))
    Next
    glx.EndVBO()

End

'' Rehace lo resaltado: la barra o el nudo bajo el mouse, y las barras seleccionadas
Public Sub ActualizarResalte()

    Dim o As Object
    Dim p1, p2 As Punto3d

    If Not VboResalte Then Return
    glx.BeginVBO(VboResalte, True)
    For Each o In e3d.model.Selection
        If o.Gender = "BARRA" Then
            p1 = e3d.model.nudo[o.ni].xyz
            p2 = e3d.model.nudo[o.nF].xyz
            glx.DrawLines3D([p1.x, p1.y, p1.z, p2.x, p2.y, p2.z], Color.DarkGreen, 2)
        Endif
    Next
    o = fmain.objHovered
    If o Then
        If o.Gender = "BARRA" Then
            p1 = e3d.model.nudo[o.ni].xyz
            p2 = e3d.model.nudo[o.nF].xyz
            glx.DrawLines3D([p1.x, p1.y, p1.z, p2.x, p2.y, p2.z], Color.Green, 2)
        Else
            glx.Drawpoints3D([o.x, o.y, o.z], Color.Green, 6)
        Endif
    Endif
    glx.EndVBO()

End

Private Sub DibujarBarras()

    Dim p1 As New Punto3d, p2 As New Punto3d, p3 As New Punto3d
    Dim ni As Integer, nF As Integer, a As Integer, q As String
    Dim colore As Long

    glx.BeginVBO(VboEstructura)

    For Each b As ClsBarra In e3d.model.barra
        p1 = e3d.model.nudo[b.ni].XYZ
        p2 = e3d.model.nudo[b.nF].xyz

        ' SetClipElement a, (x0 + x1) / 2, (y0 + y1) / 2, 2
        ' la dibujo?
        If b.tipo = 0 Then colore = Color.Black

        If (b.tipo = e3d.tipo_viga) Or (b.tipo = e3d.tipo_columna) Then colore = Color.DarkGray

        If (b.tipo = e3d.tipo_losa) Or (b.tipo = e3d.tipo_tabique) Then colore = Color.Gray

        If e3d.FiltroBarra(b, IIf(e3d.model.graficos.FiltroSector > 0, e3d.model.graficos.FiltroSector, -1),, IIf(e3d.model.graficos.FiltroTipo > 0, e3d.model.graficos.FiltroTipo, -1)) Then
            b.Visible = True
            linea(p1, p2, Colore, 1)
        Else
            b.Visible = False
        Endif

    Next
    glx.EndVBO()

End Sub

Private Sub DibujarSubBarras()

    Dim p1 As New Punto3d, p2 As New Punto3d, p3 As New Punto3d
    Dim ni As Integer, nF As Integer, a As Integer, q As String

    glx.BeginVBO(VboSubBarras)

    For Each b As ClsBarra In e3d.model.barra ' a = 1 To e3d.model.barra.Count

        If e3d.FiltroBarra(b, IIf(e3d.model.graficos.FiltroSector > 0, e3d.model.graficos.FiltroSector, -1),, IIf(e3d.model.graficos.FiltroTipo > 0, e3d.model.graficos.FiltroTipo, -1)) Then

            If b.tipo = e3d.tipo_losa Then linea(e3d.model.nudo[b.ni].xyz, e3d.model.nudo[b.nF].xyz, Color.black, 1)
        End If
    Next
    glx.EndVBO()

End Sub


            p2.Y = e3d.model.nudo[bar.nF].Y
            p2.z = e3d.model.nudo[bar.nF].z

            p3.x = p1.x + (p2.x - p1.x) / 2
            p3.y = p1.y + (p2.y - p1.y) / 2
            p3.z = p1.z + (p2.z - p1.z) / 2

            glx.Get2DpointFrom3Dworld(p3, ByRef x, ByRef y, ByRef z)
            If z > 1 Then
                x = -100
                y = -100
            End If

            If e3d.FiltroBarra(bar, IIf(e3d.model.graficos.FiltroSector > 0, e3d.model.graficos.FiltroSector, -1),, IIf(e3d.model.graficos.FiltroTipo > 0, e3d.model.graficos.FiltroTipo, -1)) Then

                ' If bar.grupo = 0 Or (e3d.model.graficos.SeDibujanSubElementos And bar.tipo <> e3d.tipo_losa) Then
                If (bar.grupo = 0) Or e3d.model.graficos.SeDibujanSubElementos Then

                    glx.DrawText2(Str(bar.Indice), x, y, 0, 12, Color.blue, Color.White,,,,, 1, 1)
                    '

                End If
            End If

        End If
    Next

    ' For a = 1 To e3d.model.nudo.max
    '
    '     p1.x = e3d.model.nudo[a].x
    '     p1.Y = e3d.model.nudo[a].Y

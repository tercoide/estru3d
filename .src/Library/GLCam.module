Public ViewPoint As New Punto3d

Public cameras As New Collection
Public camera As Camera

Public PIdiv180 As Float = Pi / 180

Public Function NewCamera(name As String) As Camera

End

Public Sub Initialize()
    ' Init With standard OGL values:

    camera = New Camera

    camera.position.x = 0
    camera.position.y = 0
    camera.position.z = 0

    camera.ViewDir.x = 0.0
    camera.ViewDir.y = 0.0
    camera.ViewDir.z = -1.0

    camera.RightVector.x = 1.0
    camera.RightVector.y = 0.0
    camera.RightVector.z = 0.0

    camera.UpVector.x = 0.0
    camera.UpVector.y = 1.0
    camera.UpVector.z = 0.0

    ' Only To be sure:
    camera.Rotated.X = 0
    camera.Rotated.Y = 0
    camera.Rotated.Z = 0.0

End

Public Sub Mover(Direction As Punto3d)

    modAlgebra.Add3D(camera.position, Direction)

End

Public Sub RotateX(Angle As Float)

    'test ok

    camera.Rotated.X += Angle

    modAlgebra.Mult3D(camera.ViewDir, Cos(Angle * PIdiv180))

    modAlgebra.Mult3D(camera.UpVector, Sin(Angle * PIdiv180))

    modAlgebra.Add3D(camera.ViewDir, camera.UpVector)

    modAlgebra.Normalizar(camera.ViewDir)

    modAlgebra.Cross(camera.ViewDir, camera.RightVector, camera.UpVector)

    modAlgebra.Mult3D(camera.UpVector, -1)

End

Public Sub RotateY(Angle As Float)

    'test ok

    camera.Rotated.Y += Angle

    modAlgebra.Mult3D(camera.ViewDir, Cos(Angle * PIdiv180))

    modAlgebra.Mult3D(camera.RightVector, -Sin(Angle * PIdiv180))

    modAlgebra.Add3D(camera.ViewDir, camera.RightVector)

    modAlgebra.Normalizar(camera.ViewDir)

    modAlgebra.Cross(camera.ViewDir, camera.UpVector, camera.RightVector)

End

Public Sub RotateZ(Angle As Float)

    ' test ok 20/1/16

    camera.Rotated.Z += Angle

    modAlgebra.Mult3D(camera.RightVector, Cos(Angle * PIdiv180))

    modAlgebra.Mult3D(camera.UpVector, Sin(Angle * PIdiv180))

    modAlgebra.Add3D(camera.RightVector, camera.UpVector)

    modAlgebra.Normalizar(camera.RightVector)

    modAlgebra.Cross(camera.ViewDir, camera.RightVector, camera.UpVector)

    modAlgebra.Mult3D(camera.UpVector, -1)

End

Public Sub Render()
    ' The point at which the camera looks:

    modAlgebra.Sum3D(ViewPoint, camera.position, camera.ViewDir)

    ' As We know the up vector, we can easily Use gluLookAt:
    glu.LookAt(camera.position.x, camera.position.y, camera.position.z,
        ViewPoint.x, ViewPoint.y, ViewPoint.z,
        camera.UpVector.x, camera.UpVector.y, camera.UpVector.z)

End

Public Sub MoveForward(Distance As Float)

    If Distance = 0 Then Return

    modAlgebra.Mult3D(camera.ViewDir, -Distance)

    modAlgebra.Add3D(camera.position, camera.ViewDir)

    modAlgebra.Mult3D(camera.ViewDir, -1 / Distance)

End

Public Sub StrafeRight(Distance As Float)

    If Distance = 0 Then Return

    modAlgebra.Mult3D(camera.RightVector, Distance)

    modAlgebra.Add3D(camera.position, camera.RightVector)

    modAlgebra.Mult3D(camera.RightVector, 1 / Distance)

End

Public Sub MoveUpward(Distance As Float)

    If Distance = 0 Then Return

    modAlgebra.Mult3D(camera.UpVector, Distance)

    modAlgebra.Add3D(camera.position, camera.UpVector)

    modAlgebra.Mult3D(camera.UpVector, 1 / Distance)

End

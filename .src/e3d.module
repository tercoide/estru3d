Public Sub PurgarBarras()
    ' corrige barras con:
    ' ni>nf
    ' .seccion = nada
    ' .material = nada

    Dim a As Integer, b As Integer, t As Integer

    For a = 1 To model.barra.Count
        ' ni>nf
        If model.barra[a].ni > model.barra[a].nF Then
            b = model.barra[a].ni
            model.barra[a].ni = model.barra[a].nF
            model.barra[a].nF = b
            t += 1

        End If

    Next
    fmain.debugInfo(("Barras corregidas ") & Str$(t), False)

End Sub

'' Elimina todos los model.nudos que no esten agarrados de alguna barra
Public Function PurgarNudos() As Integer

    Dim a As Integer, e As Integer, tengo As Boolean
    Dim t As Integer
    Dim n As ClsNudo
    Dim b As ClsBarra

    For Each n In model.nudo 'e = 1 To e3d.nud
        tengo = False
        For Each b In model.barra ' a = 1 To  model.barra.Count
            '3
            If b.ni = n.handle Then tengo = True
            If b.nF = n.handle Then tengo = True
            If tengo Then Break
        Next
        If Not tengo Then
            Inc t

            model.nudo.Remove(n.handle)
            'reacomodo las barras
            ' 2020 obsooleto
            ' For a = 1 To  model.barra.Count
            '     '3
            '     If barra[a].ni >= e Then barra[a].ni -= 1
            '     If barra[a].nF >= e Then barra[a].nF -= 1
            ' Next

        End If

    Next
    fmain.debugInfo(("Nudos sueltos purgados ") & Str$(t), False)

    Return t

End Function


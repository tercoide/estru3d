Public Function ColinealBars2(Optional modo As Integer) As Integer
    ' Look for superposed bars, blend them in such case

    'VERY IMPORTANT,

    Dim a As Integer, Found As Boolean, t As Integer, nt As Integer
    ' modo=1 se elimina la segunda barra
    ' modo=2 se suman  los datos de las barras antes de eliminar
    ' modo=3 se promedian

    'we need to check for unused stuff first
    Dim b1, b2 As ClsBarra, n As ClsNudo
    Dim bt As String

    If model.barra.Count = 0 Then Return

    e3d.flags.dibujable = False

    ' Checking all bars
    For Each b1 In model.barra

        fmain.debugInfo(("Verificando barras colineales") & Format$(b1.Indice / model.barra.Count, "0%"), True)

        Found = False
        For Each n In e3d.model.nudo

            'check if node is in between the bar
            If modAlgebra.IsBetween(e3d.model.nudo[b1.ni].xyz, e3d.model.nudo[b1.nf].xyz, n.XYZ, 0.0005) Then

                ' we need to split that bar, but only if it's not one of then

                If (n = e3d.model.nudo[b1.ni]) Or (n = e3d.model.nudo[b1.nf]) Then Continue

                If modAlgebra.Distancia(model.nudo[b1.ni].xyz, n.XYZ) < 0.0005 Then Goto nudosJuntos
                If modAlgebra.Distancia(model.nudo[b1.nf].xyz, n.XYZ) < 0.0005 Then Goto nudosJuntos

                'now we split the bar

                bt = AddBarra(n.handle, b1.nF, b1.seccion, b1.material,, False) 'NO chequear x existentes

                b1.nf = n.handle

                b2 = model.barra[bt]
                b2.grupo = b1.grupo
                b2.tipo = b1.tipo
                b2.restriccion = b1.restriccion
                Found = True
                t += 1

                'Break

            Endif

        Next
        If Not Found Then a += 1

    Next

    ' now we need to remove those bars in the same place again

    flags.cambios = True
    ' y tiene que recalcular
    flags.calculado = False
    fmain.debugInfo(("Encontradas ") & Format$(t, "0"), False)

    Return t

nudosJuntos:

    fmain.debugInfo(("Hay model.nudos demasiado juntos, eliminar model.nudos duplicados primero"), False)
    Return -1

End Function

Public Sub CorregirNumeracionBarras()

    For Each bar As Clsbarra In model.barra
        If model.nudo[bar.ni].indice > model.nudo[bar.nF].indice Then
            Swap bar.ni, bar.nf

            bar.Invertida = True
        Endif

    Next

End Sub

Public Function cpVal(numero As String) As Float

    Dim p As Integer, separador As String, busco As String
    Dim fPi As Float

    ' Reemplaza las , por . y saca el Val
    fpi = Pi  '3,1415 blablabla

    separador = Mid$(Trim$(Str$(fpi)), 2, 1)
    If separador = "," Then busco = "." Else busco = ","

    Do
        p = InStr(numero, busco)
        If p > 0 Then
            Mid$(numero, p, 1) = separador
        Else
            Exit
        End If
    Loop
    Try Return Val(numero)

End Function

Public Function cargar5(archivo As String) As Integer
    'On Error GoTo quepasoaca

    Dim t As Integer, sinerror As Integer, codigo As Integer
    Dim a As Integer, b As Integer, ok As Boolean, sdk As String
    Dim f As File, mtxt, magia As String, entry As String

    Dim l1 As New ClsLosa
    Dim v1 As New ClsViga
    Dim apoyoU As ClsApoyo
    Dim nudou As ClsNudo
    Dim barrau As ClsBarra
    Dim seccu As ClsSeccion
    Dim cnu As ClsCargaNudo
    Dim cbu As ClsCargaBarra

    sinerror = True
    codigo = True   'supongo todo ok
    magia = Space$(15)

    'Stop
    fmain.debuginfo(("Abriendo archivo ") & archivo)

    If Not Exist(archivo) Then Goto quepasoaca

    f = Open archivo For Read

    If sinerror Then

        Input #f, magiA
        If (magia <> magic5) And (magia <> magic6) Then
            Message.Warning(("Archivo no válido"))
            Return False
        Else
            model.datos.magic = magia
        End If

        Do
            If Eof(f) Then Exit
            Line Input #f, entry
            'If entry <> "" Then Exit
            entry = Trim$(entry)

            Select Case LCase$(utils.getparam(entry, 1))
                Case "nodes"

                    ' nudou.max = CInt(utils.getparam(entry, 2))

                Case "desc"
                    model.datos.descripcion = utils.getparam(entry, 2)
                Case "bars"
                    ' model.barra.Count = CInt(utils.getparam(entry, 2))

                Case "slabs"
                    model.datos.totalplacas = CInt(utils.getparam(entry, 2))
                Case "groups"
                    model.datos.TotalGrupos = CInt(utils.getparam(entry, 2))
                Case "sectors"
                    model.datos.totalSectores = CInt(utils.getparam(entry, 2))
                Case "shapes"
                    ' 2020 no interesa mas este dato
                    ' model.secciones.count = CInt(utils.getparam(entry, 2))

                    ' model.secciones.Resize( model.secciones.count + 1)
                    ' model.secciones.Fill(seccU)

                Case "nloads"
                    model.datos.totalcargasnudo = CInt(utils.getparam(entry, 2))

                Case "bloads"
                    model.datos.totalcargasbarra = CInt(utils.getparam(entry, 2))

                Case "ploads"
                    model.datos.totalcargasplacas = CInt(utils.getparam(entry, 2))
                Case "tloadrep"
                    model.envolventes.repartida = CFloat(utils.getparam(entry, 2))

                Case "restrs"
                    'datos.totalapoyos = CInt(utils.getparam(entry, 2))

                Case "type"
                    model.datos.tipo = CInt(utils.getparam(entry, 2))
                Case "units"

                    model.datos.unidades.long_nombre = utils.getparam(entry, 2)
                    model.datos.unidades.peso_nombre = utils.getparam(entry, 3)
                    model.datos.unidades.ang_nombre = utils.getparam(entry, 4)

                Case Like "nstate*"

                    a = Val(Mid$(utils.getparam(entry, 1), 7))
                    model.estados_nombre[a] = utils.getparam(entry, 2) ' & utils.getparam(entry, 3)

                Case Like "mstate*"

                    a = Val(Mid$(utils.getparam(entry, 1), 7))

                    For b = 1 To 10
                        model.combinacion[a, b] = CFloat(utils.getparam(entry, b + 1))
                    Next

                Case "node"

                    nudou = Null
                    nudou = New ClsNudo ' Punto3d 'nudotype4
                    nudou.handle = CStr(model.nudo.Count + 1)
                    model.nudo.add(nudou, CStr(model.nudo.Count + 1))

                    nudou.x = CFloat(utils.getparam(entry, 2))
                    nudou.y = CFloat(utils.getparam(entry, 3))
                    nudou.z = CFloat(utils.getparam(entry, 4))
                    '.grupo = cint(utils.getparam(entry, 5))
                    '.sector = cint(utils.getparam(entry, 6))
                    'FMain.debugInfo("nudo", .x, .y, .z, .grupo, .sector)

                Case "bar"
                    barrau = Null
                    barrau = New ClsBarra
                    barrau.handle = CStr(model.barra.Count + 1)   ' en este momento .Count es 0

                    barrau.ni = (utils.getparam(entry, 2))
                    barrau.nf = (utils.getparam(entry, 3))
                    barrau.materialText = (utils.getparam(entry, 4))
                    If e3d.material.Exist(utils.getparam(entry, 4)) Then barrau.material = e3d.GetMaterialByName(utils.getparam(entry, 4))
                    If IsNull(barrau.material) Then ' intento encontras el maerial ppor handle
                        barrau.material = e3d.GetMaterialByHandle(utils.getparam(entry, 4))
                    Endif

                    barrau.seccionText = (utils.getparam(entry, 5)) ' 2025 for backwards compat
                    If e3d.model.secciones.Exist(utils.getparam(entry, 5)) Then barrau.seccion = GetSeccionByName(utils.getparam(entry, 5))
                    barrau.restriccion = CInt(utils.getparam(entry, 6))
                    barrau.grupo = CInt(utils.getparam(entry, 7))
                    barrau.sector = CInt(utils.getparam(entry, 8))
                    barrau.tipo = CInt(utils.getparam(entry, 9))
                    barrau.Invertida = -CInt(utils.getparam(entry, 10))
                    barrau.Eje = CInt(utils.getparam(entry, 11))
                    barrau.PosX = CInt(utils.getparam(entry, 12))
                    barrau.PosZ = CInt(utils.getparam(entry, 13))

                    'FMain.debugInfo("barra", .ni, .nf, .material, .seccion, .restriccion, .grupo, .sector)

                    model.barra.Add(barraU, CStr(model.barra.Count + 1))
                    ' TODO aca iria la seccion de Placas
                    ' TODO aca iria la seccion de Grupos
                    ' TODO aca iria la seccion de Sectores

                Case "restr"
                    ' ahora los apoyos pertenecen a los nudous
                    ' debo encontrar el nudou en la Coleccion
                    ' de nudous, que ya esta cargada
                    If model.nudo.Exist(utils.getparam(entry, 2)) Then     ' verifico que el nudou exista

                        model.nudo[utils.getparam(entry, 2)].apoyo = New ClsApoyo

                        model.nudo[utils.getparam(entry, 2)].apoyo.rx = CFloat(utils.getparam(entry, 3))
                        model.nudo[utils.getparam(entry, 2)].apoyo.ry = CFloat(utils.getparam(entry, 4))
                        model.nudo[utils.getparam(entry, 2)].apoyo.rz = CFloat(utils.getparam(entry, 5))
                        model.nudo[utils.getparam(entry, 2)].apoyo.rmx = CFloat(utils.getparam(entry, 6))
                        model.nudo[utils.getparam(entry, 2)].apoyo.rmy = CFloat(utils.getparam(entry, 7))
                        model.nudo[utils.getparam(entry, 2)].apoyo.rmz = CFloat(utils.getparam(entry, 8))

                        'fmain.debugInfo("apoyo", .nudo, .rx, .ry, .rz, .rmx, .rmy, .rmz)

                    End If

                Case "slab"
                    'Print #f, "Slabs", "name", "p1", "p2, " p3 ", " p4 ", "e
                    l1 = Null
                    l1 = New ClsLosa

                    l1.nombre = utils.getparam(entry, 2)
                    l1.numero = CInt(utils.getparam())
                    l1.piso = CInt(utils.getparam())
                    l1.sector = CInt(utils.getparam())
                    l1.Nudo1 = (utils.getparam())
                    l1.Nudo2 = (utils.getparam())
                    l1.Nudo3 = (utils.getparam())
                    l1.Nudo4 = (utils.getparam())
                    l1.d = CFloat(utils.getparam())

                    mtxt = (utils.getparam())

                    If e3d.material.Exist(mtxt) Then l1.material = e3d.GetMaterialByName(mtxt)
                    If IsNull(l1.material) Then ' intento encontras el maerial ppor handle
                        l1.material = e3d.GetMaterialByHandle(mtxt)
                    Endif
                    l1.g = CFloat(utils.getparam())
                    l1.p = CFloat(utils.getparam())
                    l1.alivianado = CFloat(utils.getparam())
                    l1.dxGrid = CFloat(utils.getparam())
                    l1.dzGrid = CFloat(utils.getparam())
                    l1.nxGrid = CFloat(utils.getparam())
                    l1.nzGrid = CFloat(utils.getparam())
                    ' If .alivianado = 0 Then .alivianado = 1

                    model.losasAdd(l1)
                Case "wall"

                    utils.AddStruct(model.tabiques)

                    model.tabiques[model.tabiques.max].nombre = utils.getparam(entry, 2)
                    model.tabiques[model.tabiques.max].numero = CInt(utils.getparam())
                    model.tabiques[model.tabiques.max].piso = CInt(utils.getparam())
                    model.tabiques[model.tabiques.max].sector = CInt(utils.getparam())
                    model.tabiques[model.tabiques.max].Nudo1 = CInt(utils.getparam())
                    model.tabiques[model.tabiques.max].Nudo2 = CInt(utils.getparam())
                    model.tabiques[model.tabiques.max].Nudo3 = CInt(utils.getparam())
                    model.tabiques[model.tabiques.max].Nudo4 = CInt(utils.getparam())
                    model.tabiques[model.tabiques.max].d = CFloat(utils.getparam())
                    mtxt = (utils.getparam())

                    If e3d.material.Exist(mtxt) Then model.tabiques[model.tabiques.max].material = e3d.GetMaterialByName(mtxt)
                    If IsNull(model.tabiques[model.tabiques.max].material) Then ' intento encontras el maerial ppor handle
                        model.tabiques[model.tabiques.max].material = e3d.GetMaterialByHandle(mtxt)
                    Endif
                    model.tabiques[model.tabiques.max].g = CFloat(utils.getparam())
                    model.tabiques[model.tabiques.max].p = CFloat(utils.getparam())

                Case "beam"

                    v1 = Null
                    v1 = New ClsViga

                    v1.nombre = utils.getparam(entry, 2)
                    v1.numero = CInt(utils.getparam(entry, 3))
                    v1.piso = CInt(utils.getparam(entry, 4))
                    v1.sector = CInt(utils.getparam(entry, 5))
                    v1.nudo1 = (utils.getparam(entry, 6))
                    v1.nudo2 = (utils.getparam(entry, 7))
                    v1.seccionTxt = (utils.getparam(entry, 8))
                    v1.g = CFloat(utils.getparam(entry, 9))
                    model.vigas.Add(v1)

                Case "nload"

                    cnu = New ClsCargaNudo
                    nudou[utils.getparam(entry, 2)].cargas.add(cnu)

                    nudou[utils.getparam(entry, 2)].cargas.Last.fx = CFloat(utils.getparam(entry, 3))
                    nudou[utils.getparam(entry, 2)].cargas.Last.fy = CFloat(utils.getparam(entry, 4))
                    nudou[utils.getparam(entry, 2)].cargas.Last.fz = CFloat(utils.getparam(entry, 5))
                    nudou[utils.getparam(entry, 2)].cargas.Last.mx = CFloat(utils.getparam(entry, 6))
                    nudou[utils.getparam(entry, 2)].cargas.Last.my = CFloat(utils.getparam(entry, 7))
                    nudou[utils.getparam(entry, 2)].cargas.Last.mz = CFloat(utils.getparam(entry, 8))
                    nudou[utils.getparam(entry, 2)].cargas.Last.Estado = CInt(utils.getparam(entry, 9))
                    'fmain.debugInfo("Carganudo", .nudo, .fx, .fy, .fz, .mx, .my, .mz, .Estado)

                Case "bload"
                    cbu = New ClsCargaBarra
                    If model.barra.Exist(utils.getparam(entry, 2)) Then
                        model.barra[utils.getparam(entry, 2)].cargas.add(cbu)

                        '.barra = CInt(utils.getparam(entry, 2))
                        model.barra[utils.getparam(entry, 2)].cargas.Last.tipo = CInt(utils.getparam(entry, 3))
                        model.barra[utils.getparam(entry, 2)].cargas.Last.px = CFloat(utils.getparam(entry, 4))
                        model.barra[utils.getparam(entry, 2)].cargas.Last.py = CFloat(utils.getparam(entry, 5))
                        model.barra[utils.getparam(entry, 2)].cargas.Last.pz = CFloat(utils.getparam(entry, 6))
                        model.barra[utils.getparam(entry, 2)].cargas.Last.a = CFloat(utils.getparam(entry, 7))
                        model.barra[utils.getparam(entry, 2)].cargas.Last.b = CFloat(utils.getparam(entry, 8))
                        model.barra[utils.getparam(entry, 2)].cargas.Last.c = CFloat(utils.getparam(entry, 9))
                        model.barra[utils.getparam(entry, 2)].cargas.Last.e = CFloat(utils.getparam(entry, 10)) 'estado

                    End If

                Case "tload"
                    model.trenCargas.Add(CFloat(utils.getparam(entry, 2)))
                    model.trenDistancia.Add(CFloat(utils.getparam(entry, 3)))

                Case "tpathbar"
                    model.camino.Add(CInt(utils.getparam(entry, 2)))
                Case "tstep"
                    model.envolventes.paso_puntuales = CFloat(utils.getparam(entry, 2))
                Case "tloadrep"
                    model.envolventes.repartida = CFloat(utils.getparam(entry, 2))

                Case "shape"
                    seccu = Null
                    seccu = New ClsSeccion

                    seccu.nombre = utils.getparam(entry, 2)
                    seccu.tipo = utils.getparam(entry, 3)
                    seccu.area = CFloat(utils.getparam(entry, 4))
                    seccu.Ip = CFloat(utils.getparam(entry, 5))
                    seccu.iy = CFloat(utils.getparam(entry, 6))
                    seccu.iz = CFloat(utils.getparam(entry, 7))
                    seccu.Wp = CFloat(utils.getparam(entry, 8))
                    seccu.wy = CFloat(utils.getparam(entry, 9))
                    seccu.wz = CFloat(utils.getparam(entry, 10))
                    seccu.a = CFloat(utils.getparam(entry, 11))
                    seccu.b = CFloat(utils.getparam(entry, 12))
                    seccu.c = CFloat(utils.getparam(entry, 13))
                    seccu.d = CFloat(utils.getparam(entry, 14))
                    seccu.e = CFloat(utils.getparam(entry, 15))
                    seccu.f = CFloat(utils.getparam(entry, 16))
                    'fmain.debugInfo("Seccion", .nombre, .tipo, .area, .Ip, .iy, .iz, .Wp, .wy, .wz, .a, .b, .c, .d, .e, .f)

                    seccu.handle = CStr(model.secciones.Count)

                    model.secciones.Add(seccu, CStr(model.secciones.Count))

            End Select
        Loop

    End If
    Close f

    ' 2025 workaround tema model.secciones

    For Each barrau In e3d.model.barra
        If Not barrau.seccion Then

            barrau.seccion = e3d.model.secciones[barrau.seccionText]
        Endif
    Next

    For Each v As ClsViga In e3d.model.vigas
        If Not v.seccion Then

            v.seccion = e3d.model.secciones[v.seccionTxt]
        Endif
    Next

    fmain.debuginfo(("Se abrio exitosamente"))
    fmain.debuginfo(("Tipo de estructura: ") & Str$(model.datos.tipo))
    fmain.debuginfo(("Nodos:") & Str$(e3d.model.nudo.count))
    fmain.debuginfo(("Barras:") & Str$(e3d.model.barra.count))
    fmain.debuginfo(("Cargas:") & Str$(model.datos.totalcargasbarra + model.datos.totalcargasnudo))
    'fmain.debuginfo(("Apoyos:") & Str$(apoyos.count))

    ' pongo lo que cargue en las tablas

    'TODO

saliendos:

    ' grf.ResetMatrizRotacion  'TODO implementar

    'ok = chequeoestructura(check_vars Or check_barras Or check_nudos)

    ' verifico los materiales y los pongo en unitario

    ' For Each barrau In barra
    '
    '     barrau.material = GetMaterialByName("unitario")
    '
    '
    '     barrau.seccion = GetSeccionByName("unitaria")
    '
    '
    '
    ' Next

    Return codigo

quepasoaca:
    'esta es la rutina de errores
    ' debería seleccionar el tipo de error y avisar
    'pero no tengo ganas,asi que voy a devolver el error

    fmain.debuginfo(("Hubo un problema al abrir."), Logger.Error)
    sinerror = False
    codigo = Error
    Return

End Function

Public Function cargar6(archivo As String) As Integer
    'On Error GoTo quepasoaca

    Dim t As Integer, sinerror As Integer, codigo As Integer
    Dim a As Integer, b As Integer, ok As Boolean, sdk As String
    Dim f As File, mtxt, magia As String, entry As String

    Dim t1 As New ClsTabique
    Dim l1 As New ClsLosa
    Dim v1 As New ClsViga
    Dim c1 As ClsColumna
    Dim apoyoU As ClsApoyo
    Dim nudou As ClsNudo
    Dim barrau As ClsBarra
    Dim seccu As ClsSeccion
    Dim cnu As ClsCargaNudo
    Dim cbu As ClsCargaBarra

    Dim hBarra As String

    sinerror = True
    codigo = True   'supongo todo ok
    magia = Space$(15)

    'Stop
    fmain.debuginfo(("Abriendo archivo ") & archivo)

    If Not Exist(archivo) Then Goto quepasoaca

    f = Open archivo For Read

    If sinerror Then

        Input #f, magiA
        If (magia <> magic6) Then
            Message.Warning(("Archivo no válido"))
            Return False
        Else
            model.datos.magic = magia
        End If

        Do
            If Eof(f) Then Exit
            Line Input #f, entry
            'If entry <> "" Then Exit
            entry = Trim$(entry)

            Select Case LCase$(utils.getparam(entry, 1))
                Case "nodes"

                    ' model.nudo.max = CInt(utils.getparam(entry, 2))

                Case "desc"
                    model.datos.descripcion = utils.getparam(entry, 2)
                Case "bars"
                    ' model.barra.Count = CInt(utils.getparam(entry, 2))

                Case "slabs"
                    model.datos.totalplacas = CInt(utils.getparam(entry, 2))
                Case "groups"
                    model.datos.TotalGrupos = CInt(utils.getparam(entry, 2))
                Case "sectors"
                    model.datos.totalSectores = CInt(utils.getparam(entry, 2))
                Case "shapes"
                    ' 2020 no interesa mas este dato
                    ' model.secciones.count = CInt(utils.getparam(entry, 2))

                    ' model.secciones.Resize( model.secciones.count + 1)
                    ' model.secciones.Fill(seccU)

                Case "nloads"
                    model.datos.totalcargasnudo = CInt(utils.getparam(entry, 2))

                Case "bloads"
                    model.datos.totalcargasbarra = CInt(utils.getparam(entry, 2))

                Case "ploads"
                    model.datos.totalcargasplacas = CInt(utils.getparam(entry, 2))
                Case "tloadrep"
                    model.envolventes.repartida = CFloat(utils.getparam(entry, 2))

                Case "restrs"
                    'datos.totalapoyos = CInt(utils.getparam(entry, 2))

                Case "type"
                    model.datos.tipo = CInt(utils.getparam(entry, 2))
                Case "units"

                    model.datos.unidades.long_nombre = utils.getparam(entry, 2)
                    model.datos.unidades.peso_nombre = utils.getparam(entry, 3)
                    model.datos.unidades.ang_nombre = utils.getparam(entry, 4)

                Case Like "nstate*"

                    a = Val(Mid$(utils.getparam(entry, 1), 7))
                    model.estados_nombre[a] = utils.getparam(entry, 2) ' & utils.getparam(entry, 3)

                Case Like "mstate*"

                    a = Val(Mid$(utils.getparam(entry, 1), 7))

                    For b = 1 To 10
                        model.combinacion[a, b] = CFloat(utils.getparam(entry, b + 1))
                    Next

                Case "node"

                    nudou = Null
                    nudou = New ClsNudo ' Punto3d 'nudotype4
                    nudoU.handle = utils.getparam(entry, 2)
                    nudoU.x = CFloat(utils.getparam(entry, 3))
                    nudoU.y = CFloat(utils.getparam(entry, 4))
                    nudoU.z = CFloat(utils.getparam(entry, 5))
                    model.nudo.add(nudou, nudou.handle)

                Case "bar"
                    barrau = Null
                    barrau = New ClsBarra

                    barrau.handle = (utils.getparam(entry, 2))
                    barrau.ni = (utils.getparam(entry, 3))
                    barrau.nf = (utils.getparam(entry, 4))
                    barrau.materialText = (utils.getparam(entry, 5))
                    If e3d.material.Exist(utils.getparam(entry, 5)) Then barrau.material = e3d.GetMaterialByName(utils.getparam(entry, 5))
                    If IsNull(barrau.material) Then ' intento encontras el maerial ppor handle
                        barrau.material = e3d.GetMaterialByHandle(utils.getparam(entry, 5))
                    Endif

                    barrau.seccionText = (utils.getparam(entry, 6)) ' 2025 for backwards compat
                    'If e3d. model.secciones.Exist(utils.getparam(entry, 6)) Then
                    barrau.seccion = GetSeccionByName(utils.getparam(entry, 6))
                    'End If

                    barrau.restriccion = CInt(utils.getparam(entry, 7))
                    barrau.grupo = utils.getparam(entry, 8)
                    barrau.sector = CInt(utils.getparam(entry, 9))
                    barrau.tipo = CInt(utils.getparam(entry, 10))
                    barrau.Invertida = -CInt(utils.getparam(entry, 11))
                    barrau.Eje = CInt(utils.getparam(entry, 12))
                    barrau.PosX = CInt(utils.getparam(entry, 13))
                    barrau.PosZ = CInt(utils.getparam(entry, 14))

                    'FMain.debugInfo("barra", .ni, .nf, .material, .seccion, .restriccion, .grupo, .sector)

                    model.barra.Add(barraU, barrau.handle)
                    ' TODO aca iria la seccion de Placas
                    ' TODO aca iria la seccion de Grupos
                    ' TODO aca iria la seccion de Sectores

                Case "restr"
                    ' ahora los apoyos pertenecen a los model.nudos
                    ' debo encontrar el model.nudo en la Coleccion
                    ' de model.nudos, que ya esta cargada
                    If model.nudo.Exist(utils.getparam(entry, 2)) Then     ' verifico que el model.nudo exista

                        model.nudo[utils.getparam(entry, 2)].apoyo = New ClsApoyo

                        model.nudo[utils.getparam(entry, 2)].apoyo.rx = CFloat(utils.getparam(entry, 3))
                        model.nudo[utils.getparam(entry, 2)].apoyo.ry = CFloat(utils.getparam(entry, 4))
                        model.nudo[utils.getparam(entry, 2)].apoyo.rz = CFloat(utils.getparam(entry, 5))
                        model.nudo[utils.getparam(entry, 2)].apoyo.rmx = CFloat(utils.getparam(entry, 6))
                        model.nudo[utils.getparam(entry, 2)].apoyo.rmy = CFloat(utils.getparam(entry, 7))
                        model.nudo[utils.getparam(entry, 2)].apoyo.rmz = CFloat(utils.getparam(entry, 8))

                        'fmain.debugInfo("apoyo", .nudo, .rx, .ry, .rz, .rmx, .rmy, .rmz)

                    End If

                Case "slab"
                    'Print #f, "Slabs", "name", "p1", "p2, " p3 ", " p4 ", "e
                    l1 = Null
                    l1 = New ClsLosa

                    l1.nombre = utils.getparam(entry, 2)
                    l1.numero = CInt(utils.getparam())
                    l1.handle = utils.getparam()
                    l1.piso = CInt(utils.getparam())
                    l1.sector = CInt(utils.getparam())
                    l1.Nudo1 = (utils.getparam())
                    l1.Nudo2 = (utils.getparam())
                    l1.Nudo3 = (utils.getparam())
                    l1.Nudo4 = (utils.getparam())
                    l1.d = CFloat(utils.getparam())

                    l1.material = e3d.GetMaterialByName((utils.getparam()))

                    l1.g = CFloat(utils.getparam())
                    l1.p = CFloat(utils.getparam())
                    l1.alivianado = CFloat(utils.getparam())
                    l1.dxGrid = CFloat(utils.getparam())
                    l1.dzGrid = CFloat(utils.getparam())
                    l1.nxGrid = CFloat(utils.getparam())
                    l1.nzGrid = CFloat(utils.getparam())
                    ' If .alivianado = 0 Then .alivianado = 1

                    model.losas.Add(l1, l1.Handle)
                Case "wall"
                    t1 = New ClsTabique

                    t1.nombre = utils.getparam(entry, 2)
                    t1.numero = CInt(utils.getparam())
                    t1.Handle = utils.getparam()
                    t1.piso = CInt(utils.getparam())
                    t1.sector = CInt(utils.getparam())
                    t1.Nudo1 = CInt(utils.getparam())
                    t1.Nudo2 = CInt(utils.getparam())
                    t1.Nudo3 = CInt(utils.getparam())
                    t1.Nudo4 = CInt(utils.getparam())
                    t1.d = CFloat(utils.getparam())
                    mtxt = (utils.getparam())

                    If e3d.material.Exist(mtxt) Then t1.material = e3d.GetMaterialByName(mtxt)
                    If IsNull(t1.material) Then ' intento encontras el maerial ppor handle
                        t1.material = e3d.GetMaterialByHandle(mtxt)
                    Endif
                    t1.g = CFloat(utils.getparam())
                    t1.p = CFloat(utils.getparam())

                    model.tabiques.Add(t1, t1.Handle)

                Case "beam"

                    v1 = Null
                    v1 = New ClsViga

                    v1.nombre = utils.getparam(entry, 2)
                    v1.numero = CInt(utils.getparam(entry, 3))
                    v1.handle = utils.getparam(entry, 4)
                    v1.piso = CInt(utils.getparam(entry, 5))
                    v1.sector = CInt(utils.getparam(entry, 6))
                    v1.nudo1 = (utils.getparam(entry, 7))
                    v1.nudo2 = (utils.getparam(entry, 8))
                    v1.seccionTxt = (utils.getparam(entry, 9))
                    v1.g = CFloat(utils.getparam(entry, 10))
                    model.vigas.Add(v1, v1.Handle)

                Case "column"

                    ' Print #f, "Column", c.nombre, c.numero, c.grupo, c.piso, c.sector, c.nudo1, c.nudo2, c.seccion.nombre

                    c1 = New ClsColumna

                    c1.nombre = utils.getparam(entry, 2)
                    c1.numero = CInt(utils.getparam(entry, 3))
                    c1.handle = utils.getparam(entry, 4)
                    c1.piso = CInt(utils.getparam(entry, 5))
                    c1.sector = CInt(utils.getparam(entry, 6))
                    c1.nudo1 = (utils.getparam(entry, 7))
                    c1.nudo2 = (utils.getparam(entry, 8))
                    c1.seccionTxt = (utils.getparam(entry, 9))

                    model.columna.Add(c1, c1.Handle)

                Case "nload"

                    cnu = New ClsCargaNudo
                    model.nudo[utils.getparam(entry, 2)].cargas.add(cnu)

                    model.nudo[utils.getparam(entry, 2)].cargas.Last.fx = CFloat(utils.getparam(entry, 3))
                    model.nudo[utils.getparam(entry, 2)].cargas.Last.fy = CFloat(utils.getparam(entry, 4))
                    model.nudo[utils.getparam(entry, 2)].cargas.Last.fz = CFloat(utils.getparam(entry, 5))
                    model.nudo[utils.getparam(entry, 2)].cargas.Last.mx = CFloat(utils.getparam(entry, 6))
                    model.nudo[utils.getparam(entry, 2)].cargas.Last.my = CFloat(utils.getparam(entry, 7))
                    model.nudo[utils.getparam(entry, 2)].cargas.Last.mz = CFloat(utils.getparam(entry, 8))
                    model.nudo[utils.getparam(entry, 2)].cargas.Last.Estado = CInt(utils.getparam(entry, 9))
                    'fmain.debugInfo("Carganudo", .nudo, .fx, .fy, .fz, .mx, .my, .mz, .Estado)

                Case "bload"
                    cbu = New ClsCargaBarra

                    hbarra = utils.getparam(entry, 2)
                    If model.barra.Exist(hbarra) Then
                        barrau = model.barra[hbarra]
                        barrau.cargas.add(cbu)
                        '.barra = CInt(utils.getparam(entry, 2))
                        barrau.cargas.Last.tipo = CInt(utils.getparam(entry, 3))
                        barrau.cargas.Last.px = CFloat(utils.getparam(entry, 4))
                        barrau.cargas.Last.py = CFloat(utils.getparam(entry, 5))
                        barrau.cargas.Last.pz = CFloat(utils.getparam(entry, 6))
                        barrau.cargas.Last.a = CFloat(utils.getparam(entry, 7))
                        barrau.cargas.Last.b = CFloat(utils.getparam(entry, 8))
                        barrau.cargas.Last.c = CFloat(utils.getparam(entry, 9))
                        barrau.cargas.Last.e = CFloat(utils.getparam(entry, 10)) 'estado

                    End If

                Case "tload"
                    model.trenCargas.Add(CFloat(utils.getparam(entry, 2)))
                    model.trenDistancia.Add(CFloat(utils.getparam(entry, 3)))

                Case "tpathbar"
                    model.camino.Add(CInt(utils.getparam(entry, 2)))
                Case "tstep"
                    model.envolventes.paso_puntuales = CFloat(utils.getparam(entry, 2))
                Case "tloadrep"
                    model.envolventes.repartida = CFloat(utils.getparam(entry, 2))

                Case "shape"
                    seccu = Null
                    seccu = New ClsSeccion

                    seccu.nombre = utils.getparam(entry, 2)
                    seccu.tipo = utils.getparam(entry, 3)
                    seccu.area = CFloat(utils.getparam(entry, 4))
                    seccu.Ip = CFloat(utils.getparam(entry, 5))
                    seccu.iy = CFloat(utils.getparam(entry, 6))
                    seccu.iz = CFloat(utils.getparam(entry, 7))
                    seccu.Wp = CFloat(utils.getparam(entry, 8))
                    seccu.wy = CFloat(utils.getparam(entry, 9))
                    seccu.wz = CFloat(utils.getparam(entry, 10))
                    seccu.a = CFloat(utils.getparam(entry, 11))
                    seccu.b = CFloat(utils.getparam(entry, 12))
                    seccu.c = CFloat(utils.getparam(entry, 13))
                    seccu.d = CFloat(utils.getparam(entry, 14))
                    seccu.e = CFloat(utils.getparam(entry, 15))
                    seccu.f = CFloat(utils.getparam(entry, 16))
                    'fmain.debugInfo("Seccion", .nombre, .tipo, .area, .Ip, .iy, .iz, .Wp, .wy, .wz, .a, .b, .c, .d, .e, .f)

                    seccu.handle = CStr(model.secciones.Count)

                    model.secciones.Add(seccu, CStr(model.secciones.Count))

            End Select
        Loop

    End If
    Close f

    ' 2025 workaround tema model.secciones

    For Each barrau In e3d.model.barra
        If Not barrau.seccion Then

            barrau.seccion = e3d.model.secciones[barrau.seccionText]
        Endif
    Next

    For Each v As ClsViga In e3d.model.vigas
        If Not v.seccion Then

            v.seccion = GetSeccionByName(v.seccionTxt)
        Endif
    Next

    For Each c1 In e3d.model.columna

        c1.seccion = GetSeccionByName(c1.seccionTxt)

    Next

    e3d.ReIndexNodes()

    fmain.debuginfo(("Se abrio exitosamente"))
    fmain.debuginfo(("Tipo de estructura: ") & Str$(model.datos.tipo))
    fmain.debuginfo(("Nodos:") & Str$(e3d.model.nudo.count))
    fmain.debuginfo(("Barras:") & Str$(e3d.model.barra.count))
    fmain.debuginfo(("Cargas:") & Str$(model.datos.totalcargasbarra + model.datos.totalcargasnudo))
    'fmain.debuginfo(("Apoyos:") & Str$(apoyos.count))

    ' pongo lo que cargue en las tablas

    'TODO

saliendos:

    ' grf.ResetMatrizRotacion  'TODO implementar

    'ok = chequeoestructura(check_vars Or check_barras Or check_nudos)

    ' verifico los materiales y los pongo en unitario

    ' For Each barrau In barra
    '
    '     barrau.material = GetMaterialByName("unitario")
    '
    '
    '     barrau.seccion = GetSeccionByName("unitaria")
    '
    '
    '
    ' Next

    Return codigo

quepasoaca:
    'esta es la rutina de errores
    ' debería seleccionar el tipo de error y avisar
    'pero no tengo ganas,asi que voy a devolver el error

    fmain.debuginfo(("Hubo un problema al abrir."), Logger.Error)
    sinerror = False
    codigo = Error
    Return

End Function

Public Function chequeoestructura(tipo As Integer, Optional detallado As Boolean = False, Optional Reparar As Boolean = False) As Integer
    ' lo que voy a ver es:
    '   + si tiene los datos de las barras completos
    '   + si existen los model.nudos de cada barra
    '   + si no hay model.nudos sueltos
    '
    '----------------------------------------------------
    ' PROCESO COMUN PARA TODOS LOS TIPOS

    'On Error Resume Next
    ' TODO Try?
    Dim xxx As Float, ok As Integer, a As Integer, tabien As Boolean, ok2 As Integer
    Dim t1 As Date
    Dim TotalSectores As Integer
    Dim n As ClsNudo, b As ClsBarra
    Dim hNudo, hBarra As String

    ok = 0

    ' ERRORES CRITICOS: los chequeo si o si
    ' chequeo que todas las variables tengan valores correctos o tolerables
    ' valores minimos en las variables almacenadas en 'datos'
    If (model.datos.tipo <= 0) Then model.datos.tipo = 1

    'If model.datos.totalcargasplacas = 0 Then ok = 1

    ' idem opcionales
    If flags.asistente_actual < 0 Then flags.asistente_actual = 0
    If flags.asistente_copletado < 0 Then flags.asistente_copletado = 0

    '
    SetGL

    If (tipo And check_nudos) = check_nudos Then
        ' tiene suficientes?
        If model.nudo.Count < 2 Then
            ok = ok Or error_nudosinsuficientes
            'GoTo salida:
        End If
        ' estan todos ocupador

        a = 0
        For Each n In model.nudo
            hnudo = n.handle
            Inc a
            fmain.debuginfo(("Chequeando model.nudos ") & Format$(a / model.nudo.count, "0%"), True)
            ok2 = False
            For Each b In model.barra
                If b.ni = hNudo Then
                    ok2 = True
                    Break
                End If
                If b.nf = hNudo Then
                    ok2 = True
                    Break
                End If
            Next
            If ok2 = False Then
                ' el model.nudo no esta ocupando
                ok = ok Or error_nudossueltos
                fmain.debuginfo((" model.nudo suelto ") & hNudo, True, True)
                n.Loose = True
                If Reparar Then
                    model.nudo.Remove(model.nudo.Key) '= Null 'EliminarNudo](a)
                    fmain.debuginfo("(eliminado)", False, True)

                Endif
            Else
                n.Loose = False
            End If

        Next

    End If
    fmain.debuginfo(" ")
    If (tipo And check_barras) = check_barras Then

        If model.barra.Count < 1 Then
            ok = ok Or error_barrasinsuficientes
            'GoTo salida:
        End If
        a = 0
        For Each b In model.barra
            Inc a
            fmain.debuginfo(("Chequeando barras: ") & Format$(a / model.barra.Count, "0%"), True)
            'If b.sector > totalsectores Then totalSectores = b.sector
            ' If barra[a].nF < model.barra[a].ni Then
            '
            '     ok = ok Or error_nimayor
            '     fmain.debuginfo((" model.barra con ni>nf ->") & Format$(a, "0"), True, False)
            '     fmain.debuginfo("->", False, False)
            '
            ' End If

            If Not (model.nudo.Exist(b.nF) Or model.nudo.Exist(b.ni)) Then
                ok = ok Or error_barrassueltas
                fmain.debuginfo((" model.barra suelta ->") & n.handle, True, False)
                fmain.debuginfo("->", False, False)
            End If

            If longitud(b) = 0 Then
                ok = ok Or error_barrassueltas
                fmain.debuginfo((" model.barra de largo 0 ->") & b.handle, True, False)
                fmain.debuginfo("->", False, False)
            End If

        Next
    End If
    fmain.debuginfo(" ")
    If (tipo And check_datos) = check_datos Then

        Select Case model.datos.tipo
            Case porticoplano, porticoespacial

                ' ACA SE VERIFICABA LO DE LAS ROTULAS, PERO LO MODIFIQUE PONIENDO UN 1 EN LA DIAGONAL PPAL
                ' For a = 1 To e3d. model.nudo.max
                '     tabien = False
                '     For b = 1 To  model.barra.Count
                '         If barra[b].ni = a Then ' la model.barra tiene el model.nudo considerado
                '             If (model.barra[b].restriccion And 1) = 0 Then tabien = True
                '         Else If barra[b].nF = a Then ' la model.barra tiene el model.nudo considerado
                '             If (model.barra[b].restriccion And 2) = 0 Then tabien = True
                '         End If
                '         If tabien Then Exit 'For
                '     Next
                '     If Not tabien Then
                '         ' verifico que no haya un apoyo empotrado en ese lugar
                '         For b = 1 To e3d.apoyos.max
                '             If apoyos[b].nudo = a Then
                '                 If (apoyos[b].rmx Or apoyos[b].rmy Or apoyos[b].rmz) <> 0 Then tabien = True
                '             End If
                '             If tabien Then Exit 'For
                '         Next
                '
                '         If Not tabien Then ok = ok Or error_rotulas
                '         'GoTo salida:
                '
                '     End If
                ' Next

        End Select

        ' verifico que estén todos los datos de las barras
        If (model.datos.tipo = reticuladoplano) Or (model.datos.tipo = reticuladoespacial) Or (model.datos.tipo = porticoplano) Or (model.datos.tipo = porticoespacial) Then
            For Each b In model.barra
                If (b.seccion.area <= 0) Or (b.material.e <= 0) Then
                    ok = ok Or error_barrassindatos
                    fmain.debuginfo((" model.barra sin datos ") & Format$(a, "0"), True, False)
                    fmain.debuginfo("->", False, False)
                End If
            Next
        End If
        If (model.datos.tipo = porticoplano) Or (model.datos.tipo = porticoespacial) Then
            For Each b In model.barra
                If b.seccion.iz <= 0 Then
                    ok = ok Or error_barrassindatos
                    fmain.debuginfo((" model.barra sin datos ") & Format$(a, "0"), True, False)
                    fmain.debuginfo("->", False, False)
                End If
            Next
        End If
        If (model.datos.tipo = porticoespacial) Then
            For Each b In model.barra
                fmain.debuginfo(("Chequeando parametros: ") & Format$(a / model.barra.Count, "%00.00"), True)
                If (b.seccion.Ip <= 0) Or (b.seccion.iy <= 0) Or (b.seccion.iz <= 0) Or (b.material.g <= 0) Then
                    ok = ok Or error_barrassindatos
                    '
                    fmain.debuginfo((" model.barra sin datos ") & Format$(a, "0"), True, False)
                    fmain.debuginfo("->", False, False)
                End If

            Next

        End If

    End If
salida:
    'Stop
    fmain.debuginfo(("Chequeado en ") & Format$(Timer - t1, "0.00") & "--> " & Str$(ok), True)
    fmain.debuginfo(ErrorString(ok), True)
    fmain.cmbSectorModelo.clear
    fmain.cmbSectorModelo.Add("Todos pisos")
    For a = 1 To totalsectores
        fmain.cmbSectorModelo.Add(Format(a, "##0") & " Piso")

    Next
    If ok = 0 Then flags.dibujable = True
    Return ok

End Function

Public Function esapoyo(hnudo As Integer) As Integer

End Function

Public Function grabar(archivo As String) As Integer

    'Internacionalizacion: grabo y cargo en modo US

    ' Orden en que grabo
    '-------------------
    '   datos
    '   opcionales
    '   model.estados_nombre
    '   model.nudo
    '   barra
    '   auxiliar
    '   cargasnudo
    '   cargasbarra
    '   combinaciones
    '   informe
    '   seciones
    '   apoyos

    'obsoleto
    'If (UCase$(Right$(archivo$, 4)) <> ".CER") And (UCase$(Right$(archivo$, 4)) <> ".CE4") Then archivo$ = archivo$ + ".ce4"

    Dim sinerror As Integer, codigo As Integer, f As File
    Dim a, a1, a2 As Integer
    Dim unNudo As ClsNudo, b As ClsBarra, c As ClsColumna

    Dim cn As ClsCargaNudo, cb As ClsCargaBarra
    'Stop
    fmain.debuginfo(("Guardando el archivo ") & archivo)

    'On Error Goto quepaso
    'TODO implementar control de errores

    sinerror = True
    codigo = True   'supongo todo ok
    f = Open archivo For Write Create
    If sinerror Then
        ' paso al nuevo formato
        model.datos.magic = magic6

        Print #f, model.datos.magic
        Print #f, gb.cr
        Print #f, "WARNING: This file is not meant to edit manually as it can get unreadable."
        Print #f, gb.Cr
        Print #f, "Desc", model.datos.descripcion
        Print #f, "Nodes", model.nudo.Count
        Print #f, "Bars", model.barra.Count
        Print #f, "Slabs", model.losas.Count
        Print #f, "Walls", model.tabiques.Count
        Print #f, "Groups", model.datos.TotalGrupos
        Print #f, "Sectors", model.datos.totalsectores
        Print #f, "Shapes", model.secciones.count
        Print #f, "nLoads", model.datos.totalcargasnudo
        Print #f, "bLoads", model.datos.totalcargasbarra
        Print #f, "pLoads", model.datos.totalcargasplacas
        Print #f, "tLoads", model.trenCargas.Count
        Print #f, "Beams", model.vigas.Count
        Print #f, "Columns", model.columna.Count

        Print #f, "Type", model.datos.tipo

        Print #f, "lSlabs", "name", "numero", "piso", "Sector", "p1", "p2", "p3", "p4", " d", " material", "g", "p", "alivianado"
        For Each l As ClsLosa In model.losas
            Print #f, "Slab", l.nombre, l.numero, l.Handle, l.piso, l.sector, l.Nudo1, l.Nudo2, l.Nudo3, l.Nudo4, CStr(l.d), l.material.nombre, CStr(l.g), CStr(l.p), CStr(l.alivianado), l.dxgrid, l.dzgrid, l.nxgrid, l.nzgrid
        Next

        Print #f, "lWalls", "name", "numero", "piso", "p1", "p2", "p3", "p4", " d", " material"
        For Each t As ClsTabique In model.tabiques
            Print #f, "Wall", t.nombre, t.numero, t.Handle, t.piso, t.sector, t.Nudo1, t.Nudo2, t.Nudo3, t.Nudo4, CStr(t.d), t.material.nombre, CStr(t.g), CStr(t.p)
        Next

        Print #f, "lBeams", "name", "number", "floor", "sector", "p1", "p2", "secc", "g"
        For Each v As ClsViga In model.vigas
            Print #f, "Beam", v.nombre, v.numero, v.Handle, v.piso, v.sector, v.nudo1, v.nudo2, v.seccion.nombre, v.g
        Next

        Print #f, "lColumn", "name", "number", "group", "floor", "sector", "p1", "p2", "secc"
        For Each c In model.columna
            Print #f, "Column", c.nombre, c.numero, c.Handle, c.piso, c.sector, c.nudo1, c.nudo2, c.seccion.nombre
        Next

        Print #f, "Units", model.datos.unidades.long_nombre, model.datos.unidades.peso_nombre, model.datos.unidades.ang_nombre

        For a = 1 To 10
            Print #f, "nState" & Format$(a, "00"), model.estados_nombre[a]
        Next
        ' combinaciones
        For a = 1 To 10
            Print #f, "mState" & Format$(a, "00"),

                For a1 = 1 To 9
                Print #f, CStr(model.combinacion[a, a1]),
                    If Not sinerror Then Goto saliendo
            Next
            Print #f, CStr(model.combinacion[a, 10])

        Next

        ' 2025 ahora voy a guardar primero las model.secciones
        Print #f, "lShapes", "Name", "Type", "Area", "Ipolar", "Iy", "Iz", "Wp", "Wy", "Wz", "a", "b", "c", "d", "e", "f"
        For Each s As ClsSeccion In model.secciones

            Print #f, "Shape", s.nombre, s.tipo, CStr(s.area), CStr(s.Ip), CStr(s.iy), CStr(s.iz), CStr(s.Wp), CStr(s.wy), CStr(s.wz), CStr(s.a), CStr(s.b), CStr(s.c), CStr(s.d), CStr(s.e), CStr(s.f)

        Next

        Print #f, "lNodes", "X", "Y", "Z", "Group", "Sector"
        For Each unNudo In model.nudo

            Print #f, "Node", unnudo.handle, CStr(unnudo.x), CStr(unnudo.y), CStr(unnudo.z)

        Next
        Print #f, "lBars", "handle", "Ni", "Nf", "Mat", "Shape", "Restr", "Group", "Sector", "Tipo", "Inv", "Eje", "PosX", "PosY"
        For Each b In model.barra

            Print #f, "Bar", b.handle, b.ni, b.nf, b.material.nombre, b.seccion.nombre, b.restriccion, b.grupo, b.sector, b.tipo, CInt(b.Invertida), b.Eje, b.PosX, b.posZ

            If Not sinerror Then Goto saliendo
        Next

        ' TODO aca iria la seccion de Placas
        ' TODO aca iria la seccion de Grupos
        ' TODO aca iria la seccion de Sectores
        Print #f, "lRestr", "Node", "rX", "rY", "rZ", "rmX", "rmY", "rmZ"
        For Each unNudo In model.nudo 'a = 0 To e3d.apoyos.max
            If Not IsNull(unnudo.apoyo) Then

                Print #f, "Restr", unnudo.handle, unnudo.apoyo.rx, unnudo.apoyo.ry, unnudo.apoyo.rz, unnudo.apoyo.rmx, unnudo.apoyo.rmy, unnudo.apoyo.rmz ', un model.nudo.apoyo.mx, un model.nudo.apoyo.My, un model.nudo.apoyo.Mz, un model.nudo.apoyo.cex, un model.nudo.apoyo.cey, un model.nudo.apoyo.cez, un model.nudo.apoyo.cefix, un model.nudo.apoyo.cefiy, un model.nudo.apoyo.cefiz, un model.nudo.apoyo.efix, un model.nudo.apoyo.efiy, un model.nudo.apoyo.efiz, un model.nudo.apoyo.mfix, un model.nudo.apoyo.mfiy, un model.nudo.apoyo.mfiz

            End If

            If Not sinerror Then Goto saliendo
        Next

        Print #f, "lnLoads", "Node", "Fx", "Fy", "Fz", "Mx", "My", "Mz", "State"
        For Each unNudo In model.nudo ' a = 1 To model.datos.totalcargasnudo
            For Each cn In unnudo.cargas

                Print #f, "nLoad", unnudo.handle, CStr(cn.fx), CStr(cn.fy), CStr(cn.fz), CStr(cn.mx), CStr(cn.my), CStr(cn.mz), cn.Estado

            Next

        Next

        Print #f, "lbLoads", "Bar", "Type", "Px", "Py", "Pz", "a", "b", "c", "State"
        For Each b In model.barra ' a = 1 To model.datos.totalcargasbarra
            For Each cb In b.cargas

                ' no grabo las combinaciones porque se recalculan al cargar
                If cb.e <= 10 Then Print #f, "bLoad", b.handle, cb.tipo, CStr(cb.px), CStr(cb.py), CStr(cb.pz), CStr(cb.a), CStr(cb.b), CStr(cb.c), cb.e 'estado

            Next
        Next

        Print #f, "tLoadRep", CStr(model.envolventes.repartida)  ' TODO ubicar esto en el lugar correspondiente
        Print #f, "tStep", model.envolventes.paso_puntuales
        Print #f, "tLoads", "tLoad", "tDistance"
        For a = 1 To model.trenCargas.Count

            Print #f, "tLoad", CStr(model.trenCargas[a - 1]), CStr(model.trenDistancia[a - 1])

        Next

        ' cargo el camino del tren
        Print #f, "tPathBars", "tBar"

        For a = 1 To model.Camino.Count

            Print #f, "tPathBar", CStr(model.camino[a - 1])

        Next

        flags.cambios = False

    Else    'o sea que ni pudo abrir el archivo

        Goto saliendo

    End If
    Close f
    fmain.debuginfo(("Se guardo con exito"))

    Goto saliendo

quepaso:
    'esta es la rutina de errores
    ' debería seleccionar el tipo de error y avisar
    'pero no tengo ganas,asi que voy a devolver el error

    sinerror = False
    codigo = Error
    'Resume Next 'TODO implementar
saliendo:
    Return codigo

End Function

Public Function longitud(b As ClsBarra) As Float
    ' devuelve la longitud de la barra

    ' en caso de no existir alguno de los model.nudos, la siguiente instruccion dara error
    Try Return (((model.nudo[b.nF].x - model.nudo[b.ni].x) ^ 2 + (model.nudo[b.nF].y - model.nudo[b.ni].y) ^ 2 + (model.nudo[b.nF].z - model.nudo[b.ni].z) ^ 2)) ^ 0.5
    Return 0

End Function

Public Function lx(bar As ClsBarra) As Float

    Try Return model.nudo[bar.nF].x - model.nudo[bar.ni].x
    Return 0

End Function

Public Function ly(bar As ClsBarra) As Float

    Try Return model.nudo[bar.nF].y - model.nudo[bar.ni].y
    Return 0

End Function

Public Function lz(bar As ClsBarra) As Float

    Try Return model.nudo[bar.nF].z - model.nudo[bar.ni].z
    Return 0

End Function

Public Sub no_escribe_mas()

    escribiendo = False
    textgrid = ""
    egr = 0
    egc = 0

End Sub

Public Function nudos_dobles(Optional tol As Float = 10e-5) As Integer
    ' esta rutina corrige el problema de model.nudos en el mismo lugar físico

    Dim a As Integer, b As Integer, c As Integer, d As Integer, t As Integer

    a = 0
    For Each nudo1 As ClsNudo In model.nudo

        For Each nudo2 As ClsNudo In model.nudo
            If nudo1.handle = nudo2.handle Then Continue
            If Abs(nudo1.x - nudo2.x) < tol And Abs(nudo1.Y - nudo2.Y) < tol And Abs(nudo1.z - nudo2.z) < tol Then
                ' esta es la rutina que reemplaza los valores en el array barras
                ' 1-debo eliminar el model.nudo b de todas la barras y reemplazarlo por el a

                For Each bar As ClsBarra In model.barra
                    '1
                    If bar.ni = nudo1.handle Then bar.ni = nudo2.handle
                    If bar.nF = nudo1.handle Then bar.nF = nudo2.handle

                Next

                model.nudo.Remove(nudo1.handle)

            End If
        Next
    Next

    flags.cambios = True
    ' y tiene que recalcular
    flags.calculado = False

    fmain.SetStatus
    Return t

End Function

Public Sub dibujable()
    ' Verifica si la estructura se puede dibujar y llama a setstatus

    Dim a As Integer

    If e3d.model.graficos.cambios Then
        If chequeoestructura(check_barras Or check_nudos) = 0 Then
            flags.dibujable = True
            e3d.model.graficos.cambios = False
        Else
            ' si no la puedo dibujar, es que hay cambios
            flags.dibujable = False
            flags.dibujado = False
            e3d.model.graficos.cambios = True

        End If
    End If

End Sub

Public Sub escalar()

    Dim a As Integer, b As Integer, Dyz As Float
    Dim unaBarra As ClsBarra, unNudo As ClsNudo
    ' Calculo las escalas de los esfuerzos
    ' obtengo los máximos genereales

    '[pero primero pongo en cero]
    e3d.model.graficos.maxMz = 0
    e3d.model.graficos.maxMy = 0
    e3d.model.graficos.maxT = 0
    e3d.model.graficos.maxQy = 0
    e3d.model.graficos.maxN = 0
    e3d.model.graficos.maxQz = 0

    'Stop
    e3d.model.graficos.escala_esf = 0
    e3d.model.graficos.ESCmz = 1
    e3d.model.graficos.ESCmy = 1
    e3d.model.graficos.ESCt = 1
    e3d.model.graficos.ESCqy = 1
    e3d.model.graficos.ESCn = 1
    e3d.model.graficos.ESCqz = 1

    For Each unaBarra In model.barra ' a = 1 To  model.barra.Count

        If Abs(unabarra.EsfExtBar.maxMz) > e3d.model.graficos.maxMz Then e3d.model.graficos.maxMz = Abs(unabarra.EsfExtBar.maxMz)
        If Abs(unabarra.EsfExtBar.maxMy) > e3d.model.graficos.maxMy Then e3d.model.graficos.maxMy = Abs(unabarra.EsfExtBar.maxMy)
        If Abs(unabarra.EsfExtBar.maxT) > e3d.model.graficos.maxT Then e3d.model.graficos.maxT = Abs(unabarra.EsfExtBar.maxT)
        If Abs(unabarra.EsfExtBar.maxQy) > e3d.model.graficos.maxQy Then e3d.model.graficos.maxQy = Abs(unabarra.EsfExtBar.maxQy)
        If Abs(unabarra.EsfExtBar.maxN) > e3d.model.graficos.maxN Then e3d.model.graficos.maxN = Abs(unabarra.EsfExtBar.maxN)
        If Abs(unabarra.EsfExtBar.maxQz) > e3d.model.graficos.maxQz Then e3d.model.graficos.maxQz = Abs(unabarra.EsfExtBar.maxQz)

        If Abs(unabarra.EsfExtBar.minMz) > e3d.model.graficos.maxMz Then e3d.model.graficos.maxMz = Abs(unabarra.EsfExtBar.minMz)
        If Abs(unabarra.EsfExtBar.minMy) > e3d.model.graficos.maxMy Then e3d.model.graficos.maxMy = Abs(unabarra.EsfExtBar.minMy)
        If Abs(unabarra.EsfExtBar.minT) > e3d.model.graficos.maxT Then e3d.model.graficos.maxT = Abs(unabarra.EsfExtBar.minT)
        If Abs(unabarra.EsfExtBar.minQy) > e3d.model.graficos.maxQy Then e3d.model.graficos.maxQy = Abs(unabarra.EsfExtBar.minQy)
        If Abs(unabarra.EsfExtBar.minN) > e3d.model.graficos.maxN Then e3d.model.graficos.maxN = Abs(unabarra.EsfExtBar.minN)
        If Abs(unabarra.EsfExtBar.minQz) > e3d.model.graficos.maxQz Then e3d.model.graficos.maxQz = Abs(unabarra.EsfExtBar.minQz)

    Next
    If e3d.model.graficos.escala_esf < e3d.model.graficos.maxMz Then e3d.model.graficos.escala_esf = e3d.model.graficos.maxMz
    If e3d.model.graficos.escala_esf < e3d.model.graficos.maxMy Then e3d.model.graficos.escala_esf = e3d.model.graficos.maxMy
    If e3d.model.graficos.escala_esf < e3d.model.graficos.maxT Then e3d.model.graficos.escala_esf = e3d.model.graficos.maxT
    If e3d.model.graficos.escala_esf < e3d.model.graficos.maxQy Then e3d.model.graficos.escala_esf = e3d.model.graficos.maxQy
    If e3d.model.graficos.escala_esf < e3d.model.graficos.maxN Then e3d.model.graficos.escala_esf = e3d.model.graficos.maxN
    If e3d.model.graficos.escala_esf < e3d.model.graficos.maxQz Then e3d.model.graficos.escala_esf = e3d.model.graficos.maxQz
    If e3d.model.graficos.escala_esf = 0 Then e3d.model.graficos.escala_esf = 1

    ' el maximo esf sera la mitad de la model.barra mas corta
    e3d.model.graficos.escala_esf = (e3d.model.graficos.barra_larga * 0.5 + e3d.model.graficos.barra_corta * 0.5 + e3d.model.graficos.largo_estructura * 0.25) / 3 / e3d.model.graficos.escala_esf

    ' ahora lo de la elastica
    e3d.model.graficos.FactorFlecha = 0
    For Each unNudo In model.nudo '  a = 1 To e3d. model.nudo.max
        If e3d.model.graficos.FactorFlecha < Sqr(unnudo.dezplazamientos.dz ^ 2 + unnudo.dezplazamientos.dy ^ 2 + unnudo.dezplazamientos.dx ^ 2) Then e3d.model.graficos.FactorFlecha = Sqr(unnudo.dezplazamientos.dz ^ 2 + unnudo.dezplazamientos.dy ^ 2 + unnudo.dezplazamientos.dx ^ 2)
    Next

    ' que pasa si todos los model.nudos son apoyos?
    For Each unNudo In model.nudo '  a = 1 To e3d. model.nudo.max
        If e3d.model.graficos.FactorFlecha < Sqr(unnudo.dezplazamientos.dfiy ^ 2 + unnudo.dezplazamientos.dfiz ^ 2) / 2 Then
            e3d.model.graficos.FactorFlecha = Sqr(unnudo.dezplazamientos.dfiz ^ 2 + unnudo.dezplazamientos.dfiy ^ 2) / 2

        End If
    Next

    'pero si son todos apoyos, y ademas son todos empotramientos
    If e3d.model.graficos.FactorFlecha = 0 Then
        For Each aBar As ClsBarra In model.barra
            clc.generar_elastica(aBar)
            fmain.debugInfo(("Generando elastica ") & Format$(aBar.indice / model.barra.count, "0.00%"), True)
            dyz = Sqr(model.vectorE[e3d.setting.IntervaloElastica / 2].Y ^ 2 + model.vectorE[e3d.setting.IntervaloElastica / 2].z ^ 2)

            If e3d.model.graficos.FactorFlecha < dyz * longitud(aBar) / 2 Then
                e3d.model.graficos.FactorFlecha = dyz * longitud(aBar) / 2

            End If

        Next

    Endif

    If e3d.model.graficos.FactorFlecha < 1E-40 Then e3d.model.graficos.FactorFlecha = 1
    If e3d.model.graficos.FactorFlecha > 1E+40 Then e3d.model.graficos.FactorFlecha = 1

    ' ahora lo relaciono con la model.barra mas corta
    e3d.model.graficos.FactorFlecha = e3d.model.graficos.barra_larga * 0.05 / e3d.model.graficos.FactorFlecha

End Sub


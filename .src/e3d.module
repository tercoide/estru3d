Public Sub mats_load2()
    ' using params component

    Dim paso As Integer, a As Integer, nnn As String
    Dim matU As New ClsMaterial

    paso = 1
    material.clear

    ' cargo el material cero

    matu = Null
    matu = New ClsMaterial
    matu.nombre = ("Unitario")
    matu.densidad = 1
    matu.e = 1
    matu.g = 1
    matu.fluencia = 1
    matu.handle = "0"

    material.Add(matu, matu.nombre)

    fmain.debuginfo(("Cargando tabla de materiales") & nnn)

    For a = 1 To 20
        matu = Null
        matu = New ClsMaterial
        matu.handle = CStr(a)
        matu.nombre = Replace(Mats["Material" & Format$(a, "0") & "/Name", "<unnamed>"], " ", "_")
        matu.e = Mats["Material" & Format$(a, "0") & "/E", "1"]
        matu.g = Mats["Material" & Format$(a, "0") & "/G", "1"]
        matu.fluencia = Mats["Material" & Format$(a, "0") & "/F", "1"]
        matu.densidad = Mats["Material" & Format$(a, "0") & "/D", "1"]

        ' E , G y Fluencia en kilo/cm2
        ' Densidad en kilo/m3
        ' Los factores multiplican estas unidades para llevarlas a las
        ' del usuario
        matu.e *= model.datos.unidades.factorEG
        matu.g *= model.datos.unidades.factorEG
        matu.fluencia *= model.datos.unidades.factorEG
        matu.densidad *= model.datos.unidades.factorDEN
        material.Add(matu, matu.nombre)

    Next

    Return

nopude1:
    'MsgBox "No puede abrirse la libreria de materiales."

End Sub

Public Sub calcular_factores()
    ' calcula los factores de las unidades
    ' Primero las pongo en uno

    model.datos.unidades.factorEG = 1
    model.datos.unidades.factorDEN = 1
    model.datos.unidades.factorSUP = 1
    model.datos.unidades.factorLONG = 1
    fmain.debuginfo(("Calculando los factores de las unidades"))

    'Stop
    Select Case LCase$(model.datos.unidades.peso_nombre)
        Case "tons"
            model.datos.unidades.factorEG = model.datos.unidades.factorEG / 1000
            model.datos.unidades.factorDEN = model.datos.unidades.factorDEN / 1000

        Case "kilo"
            ' nada!!! porque es default
        Case "pndf"
            model.datos.unidades.factorEG = model.datos.unidades.factorEG * 2.2046
            model.datos.unidades.factorDEN = model.datos.unidades.factorDEN * 2.2046
        Case "knwt"
            model.datos.unidades.factorEG = model.datos.unidades.factorEG * 0.00980665
            model.datos.unidades.factorDEN = model.datos.unidades.factorDEN * 0.00980665
        Case Else
            model.datos.unidades.peso_nombre = "kilo"
    End Select

    Select Case LCase$(model.datos.unidades.long_nombre)
        Case "metr"

            model.datos.unidades.factorLONG = model.datos.unidades.factorLONG
            model.datos.unidades.factorSUP = model.datos.unidades.factorSUP
            model.datos.unidades.factorEG = model.datos.unidades.factorEG * 100 ^ 2

        Case "cent"
            model.datos.unidades.factorLONG = model.datos.unidades.factorLONG * 100
            model.datos.unidades.factorSUP = model.datos.unidades.factorSUP * 100 ^ 2
            model.datos.unidades.factorEG = 1  'default
            model.datos.unidades.factorDEN = model.datos.unidades.factorDEN / 100 ^ 3
        Case "inch"
            model.datos.unidades.factorLONG = model.datos.unidades.factorLONG * 39.37007874015748
            model.datos.unidades.factorSUP = model.datos.unidades.factorSUP * 39.37007874015748 ^ 2
            model.datos.unidades.factorEG = model.datos.unidades.factorEG / 39.37007874015748 ^ 2
            model.datos.unidades.factorDEN = model.datos.unidades.factorDEN / 39.37007874015748 ^ 3
        Case "feet"
            model.datos.unidades.factorLONG = model.datos.unidades.factorLONG * 3.280839895013123
            model.datos.unidades.factorSUP = model.datos.unidades.factorSUP * 3.280839895013123 ^ 2
            model.datos.unidades.factorEG = model.datos.unidades.factorEG / 3.280839895013123 ^ 2
            model.datos.unidades.factorDEN = model.datos.unidades.factorDEN / 3.280839895013123 ^ 3
        Case Else
            model.datos.unidades.long_nombre = "metr"
    End Select

    Select Case LCase$(model.datos.unidades.ang_nombre)
        Case "rads"
            ' nada!!! porque es default
        Case "grad"
            model.datos.unidades.factorANG = model.datos.unidades.factorANG * 180 / 3.141567
        Case Else
            model.datos.unidades.ang_nombre = "rads"

    End Select

End Sub


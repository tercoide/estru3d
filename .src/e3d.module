Public Sub WebAction(cmd As String)

    Dim a As Integer

    Select Case cmd
        Case "info"
            ' muestro la ventana info
            formInfo.Showmodal

            If flags.modo = 3 Then Asistir

        Case "purgarnudos"
            PurgarNudos
            If flags.modo = 3 Then Asistir

        Case "purgarbarras"
            PurgarBarras
            If flags.modo = 3 Then Asistir

        Case "nudos"
            FormNudos.Showmodal

            If flags.modo = 3 Then Asistir
        Case "barras"
            FormBarras.Showmodal
            If flags.modo = 3 Then Asistir
        Case "extremos"
            'extremos.Show 1

            If flags.modo = 3 Then Asistir

        Case "apoyos"
            formApoyos.ShowModal

            If flags.modo = 3 Then Asistir
        Case "cargas"
            formCargasNudos.ShowModal

            If flags.modo = 3 Then Asistir
        Case "calcular"
            '
            flags.modo = 1
            fmain.SetStatus
            '    Stop
            clc.IniciarCalculos

    End Select

End Sub

Public Sub SetGL()

    Select Case model.datos.tipo
        Case 0, porticoplano
            clc.gr = 3
            model.datos.tipo = porticoplano

        Case reticuladoplano
            clc.gr = 2
        Case porticoplano, reticuladoespacial
            clc.gr = 3
        Case porticoespacial
            clc.gr = 6
    End Select

End Sub

Public Sub main()

    'tareas en caso de que sea la primera vez que se corra el programa, o su actualizacion

    Debug Application.Args[0]
    Debug Application.Args[1]
    Debug Application.Args[2]
    Debug Application.Args[3]

    FirstRun

    ' todo en orden

    Inicializar

    fmain.Show

End

Public Function EscribeUnidadesDeMedida() As String
    'tiene que ser un textlabel para que admita etiquetas html

    Dim texto As String

    Texto = "<center>" & "<i>" & ("Unidades de Medidas:") & " </i>" & "<br>" & " <b>" & ("Longitud:") & "</b> " & model.datos.unidades.long_nombre
    texto &= " <b>" & ("Peso:") & "</b> " & model.datos.unidades.peso_nombre
    texto &= " <b>" & ("Angulo:") & "</b> " & model.datos.unidades.ang_nombre
    texto &= "</center>"

    Return texto

End

Public Sub Inicializar()
    'variables

    Dim a As Integer, p1 As New Punto3d, p2 As New Punto3d, px As New Punto3d
    Dim LibPath As String, LibVersion As Float
    'forzamos a utilizar ingles, esto sirve para usuarios de otro idioma que no tienen spanish instalado
    If Application.Args[1] = "-en" Then System.Language = "en_US.UTF-8"

    Tutoriales = New Settings(Application.Path &/ "/hlp" &/ flags.lenguaje &/ "tutorial.estru3d-lib", "Tutoriales")

    'Debug Application.Dir

    'Debug Application.Name

    extremos[0] = "+---+"  'empotrada
    extremos[1] = "o---+"  'empotrada-rotula
    extremos[2] = "+---o"
    extremos[3] = "o---o"
    extremos[4] = "<--->"  'tensor

    model = New Model
    PonerEnCero()
    model.graficos.colores.barras = 180
    model.graficos.colores.seleccion = 60

    flags.OcultarCargas = True
    flags.MostrarDespuesCalculo = 1 ' Mz
    'Cargo los settings

    setting.formato_datos = parametros["Options/DataFormat", "0.00"]
    setting.formato = parametros["Options/ResultsFormat", "0.00"]
    e3d.flags.ayuda = Application.Path &/ "/hlp" &/ flags.lenguaje &/ "bienv.htm"
    e3d.flags.ayuda = Application.Path &/ "/hlp" &/ e3d.flags.lenguaje &/ "index.htm"
    e3d.setting.IntervaloElastica = 20
    setting.solver = parametros["Options/Solver", "4"]

    FontList = glx.LoadFonts(config.dirResources &/ "Librerias/fonts/lff")
    'FontList = glx.LoadFonts(gcd.sFonts)
    glx.SelectFont("romans")

    Return

End

Public Sub NuevoProyecto()

    PonerEnCero

    fmain.SetStatus

End Sub

Public Sub aEsfSec(hbarra As Integer, secc As Integer, esfuerzo As Integer, valor As Float)

    ' coloca el valor en la seccion
    ' como todo es 1 to xxxx, resto 1 a todo
    Dim pos As Long
    ' esfsecarray.resize ( barras * setting.pasoc * 6)
    ' 10 barras, 20 model.secciones + 1 , 6 espacial -> 10 * 21 * 6 = 1260 elementos
    '
    pos = (esfuerzo - 1) + secc * 6 + (hbarra - 1) * (setting.PasoCalcularEsfuerzos + 1) * 6

    model.esfsecarray[pos] = valor

End

Public Function EsfSec(hbarra As Integer, secc As Integer, esfuerzo As Integer) As Float

    ' devuelve el valor en la seccion
    ' como todo es 1 to xxxx, resto 1 a todo
    Dim pos As Long

    pos = (esfuerzo - 1) + secc * 6 + (hbarra - 1) * (setting.PasoCalcularEsfuerzos + 1) * 6

    Return model.esfsecarray[pos]

End

Public Function EsfSecNeg(hbarra As Integer, secc As Integer, esfuerzo As Integer) As Float

    ' devuelve el valor en la seccion
    ' como todo es 1 to xxxx, resto 1 a todo
    Dim pos As Long

    pos = (esfuerzo - 1) + secc * 6 + (hbarra - 1) * (setting.PasoCalcularEsfuerzos + 1) * 6

    Return model.esfsecarrayNeg[pos]

End

Public Function EsfSecPos(hbarra As Integer, secc As Integer, esfuerzo As Integer) As Float

    ' devuelve el valor en la seccion
    ' como todo es 1 to xxxx, resto 1 a todo
    Dim pos As Long

    pos = (esfuerzo - 1) + secc * 6 + (hbarra - 1) * (setting.PasoCalcularEsfuerzos + 1) * 6

    Return model.esfsecarrayPos[pos]

End

' idem(model.losas
Public Sub aEsfSecLosas(hLosa As ClsLosa, x As Integer, Z As Integer, direccion As Integer, esfuerzo As Integer, valor As Float)

    ' coloca el valor en la cuadricula de las(model.losas
    ' las(model.losas son de nX x nY cuadrados
    ' por lo tanto el array sera de: A = 6 esfuerzos x (nX + 1) x (nY + 1)
    ' cuando creo el array acumulador, sera de la sumatoria de A(l)
    '
    Dim pos As Long
    ' El indice en el array acumulador se obtiene por
    pos = hLosa.EsfSecArrayLosasIndex 'model.EsfSecArrayLosasIndex[hLosa]

    ' y la posicion adecuada, considereando que acumulamos por filas X
    pos += (direccion - 1) + (esfuerzo - 1) * 2 + Z * (hlosa.nxGrid + 1) * 6 * 2 + X * 6 * 2

    model.EsfSecArrayLosas[pos] = valor

End

Public Function EsfSecLosas(hLosa As ClsLosa, x As Integer, Z As Integer, direccion As Integer, esfuerzo As Integer) As Float

    ' devuelve el valor en la cuadricula
    Dim pos As Long
    ' El indice en el array acumulador se obtiene por
    pos = hLosa.EsfSecArrayLosasIndex 'model.EsfSecArrayLosasIndex[hLosa]

    ' y la posicion adecuada, considereando que acumulamos por filas X
    pos += (direccion - 1) + (esfuerzo - 1) * 2 + Z * (hlosa.nxGrid + 1) * 6 * 2 + X * 6 * 2

    Return model.EsfSecArrayLosas[pos]

End

Public Sub LlenarGridLosas()

    ' llena el array de esfuerzos en las(model.losas
    Dim l As Clslosa
    Dim pos As Integer
    Dim pX As Integer ' posicion X
    Dim pZ As Integer ' posicion Z
    Dim d As Integer ' la direccion del esfuerzo a considerar
    Dim b As Integer ' barras
    Dim E As Float ' el esfuerzo
    Dim E2 As Float
    Dim esfuerzo As Integer
    Dim nudoI, nudoF As String

    Dim s As String

    For Each l In model.losas
        l.GridLosasIndex = pos
        pos += 3 * (l.nxGrid + 1) * (l.nzGrid + 1)
    Next

    model.arrGridlosas.Resize(pos) '(model.GridLosasIndex[l] + 3 * (model.losas[l].nxGrid + 1) * (model.losas[l].nzGrid + 1))

    ' ahora empiezo a acumular
    For Each bar As ClsBarra In model.barra
        If bar.tipo = tipo_losa Then ' es parte de una losa?
            l = model.losas[bar.grupo] ' numero de losa
            pX = bar.PosX  ' en general las posiciones 0 y ultimas quedan reemplaadas por model.vigas
            pZ = bar.PosZ
            d = bar.Eje '1=X 2=Z
            nudoI = bar.ni
            nudoF = bar.Nf

            If bar.Invertida Then Swap nudoI, nudoF

            'veo que pasa con la posicion
            If (d = 1) And (pX = 1) Then
                '  ademas cargo el punto
                aGridLosas(l, 0, pZ, model.nudo[NudoI].x, model.nudo[Nudoi].y, model.nudo[Nudoi].z)
            Else If (d = 2) And (pZ = 1) Then ' tomo el esfuerzo en el inicio

                '  ademas cargo el punto
                aGridLosas(l, pX, 0, model.nudo[NudoI].x, model.nudo[NudoI].y, model.nudo[NudoI].z)
            End If

            aGridLosas(l, pX, pz, model.nudo[NudoF].x, model.nudo[NudoF].y, model.nudo[NudoF].z)

        End If
    Next

    For Each l In model.losas
        ' acumulo los limites de las(model.losas
        aGridLosas(l, 0, 0, model.nudo[l.Nudo1].x, model.nudo[l.Nudo1].y, model.nudo[l.Nudo1].z)
        aGridLosas(l, 0, l.nzgrid, model.nudo[l.Nudo3].x, model.nudo[l.Nudo3].y, model.nudo[l.Nudo3].z)
        aGridLosas(l, l.nxgrid, 0, model.nudo[l.Nudo2].x, model.nudo[l.Nudo2].y, model.nudo[l.Nudo2].z)
        aGridLosas(l, l.nxGrid, l.nzgrid, model.nudo[l.Nudo4].x, model.nudo[l.Nudo4].y, model.nudo[l.Nudo4].z)

    Next

End

' idem(model.losas
Public Sub aGridLosas(hLosa As ClsLosa, X As Integer, Z As Integer, x0 As Float, y0 As Float, z0 As Float)

    ' coloca el valor en la cuadricula de las(model.losas
    ' las(model.losas son de nX x nY cuadrados
    ' por lo tanto el array sera de: A = 6 esfuerzos x (nX + 1) x (nY + 1)
    ' cuando creo el array acumulador, sera de la sumatoria de A(l)
    '
    Dim pos As Long
    ' El indice en el array acumulador se obtiene por
    pos = hlosa.GridLosasIndex 'model.GridLosasIndex[hLosa]

    ' y la posicion adecuada, considereando que acumulamos por filas X
    pos += Z * (hlosa.nxGrid + 1) * 3 + X * 3

    model.arrGridLosas[pos] = x0
    model.arrGridLosas[pos + 1] = y0
    model.arrGridLosas[pos + 2] = z0

End

' Public Sub GridLosas(hLosa As Integer, x As Integer, Z As Integer, ByRef X0 As Float, ByRef y0 As Float, ByRef z0 As Float)
'
'     ' devuelve el valor en la cuadricula

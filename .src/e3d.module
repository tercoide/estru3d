Public Function AddNudo(x As Float, Y As Float, z As Float, Optional CheckExisting As Boolean, Tolerance As Float = 1e-5, Auxiliar As Boolean = False) As String
    ' devuelve el numero de model.nudo o cero en caso de error

    'Tolerance: to surpass numerical tricks comparing coordinates,
    'ie: x = 12.50 tests True against x0 = 12.50001 if tolerance = 0.005
    'then no new node is created

    Dim a As Integer
    Dim n As ClsNudo
    ' primero chequeo que no exista
    If CheckExisting Then

        For Each n In model.nudo
            If (Abs(n.x - x) <= Tolerance) And (Abs(n.Y - Y) <= tolerance) And (Abs(n.z - z) <= Tolerance) Then

                ' encontre un model.nudo con las mismas coordenadas, devuelvo su posicion
                If auxiliar = False Then n.Auxiliar = False
                Return n.handle

            End If
        Next
    End If

    ' ahora veo si el array tiene elementos extra disponibles

    Dim nudou As New ClsNudo 'nudotype4
    Dim LastIndex As Integer
    Try LastIndex = model.nudo[model.nudo.Last].indice
    nudou.handle = GetNewHandle()
    nudoU.x = x
    nudoU.Y = Y
    nudoU.z = z
    nudou.Indice = LastIndex + 1
    nudou.Auxiliar = auxiliar

    model.nudo.Add(nudou, nudou.handle)

    flags.cambios = True
    flags.calculado = False

    Return nudou.handle

End Function

'' Devuelve un handle disponible
Fast Public Function GetNewHandle() As String

    Dim s As String

    Do

        Inc model.LastHandle

        s = Hex(model.LastHandle)
        If Not model.partes.Exist(s) Then Break
    Loop
    Return s

End

Fast Public Function ReIndexNodes() As Boolean
    ' los indices de los model.nudos van de 1 a nNudos

    Dim i As Integer

    For Each n As ClsNudo In model.nudo
        Inc i
        n.indice = i

    Next
    i = 0
    For Each b As Clsbarra In model.barra
        Inc i
        b.indice = i

    Next

End

Public Function AddBarra(nudo_inicial As String, nudo_final As String, Optional sSeccion As ClsSeccion, sMaterial As ClsMaterial, rotulas As Integer = 0, CheckExisting As Boolean = False) As String
    ' 2025 la vamos a mejorar para ue acepte mas cosas
    ' devuelve el numero de model.barra o cero en caso de error
    ' rotulas:  0=sin rotulas, 1=rotula en model.nudo inicial, 2=en model.nudo final, 3=en ambos
    ' material y seccion: numero de orden o cero

    Dim d As Integer
    Dim b As ClsBarra
    ' primero chequeo que no exista
    If CheckExisting Then
        For Each b In model.barra 'd = 1 To  model.barra.Count
            If (b.nF = nudo_final) And (b.ni = nudo_inicial) Then
                Return b.handle

            End If
        Next
    End If

    ' agrego una barra
    flags.cambios = True
    flags.calculado = False

    Dim barrau As New ClsBarra

    barrau.ni = nudo_inicial  '2020 what if node doesnt exist?
    barrau.nF = nudo_final
    barrau.handle = GetNewHandle()

    If smaterial Then

        barrau.material = sMaterial
    Else

        barrau.material = GetMaterialByName("unitario")

    End If

    If sseccion Then
        barrau.seccion = sseccion
    Else
        barrau.seccion = GetSeccionByName("unitaria")

    End If

    barrau.grupo = 0
    barrau.restriccion = rotulas

    model.barra.Add(barrau, barrau.handle)

    Return barrau.handle

End Function


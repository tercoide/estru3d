Public Function GetMaxGrid() As Integer

    Dim L As ClsLosa, c As Integer

    For Each L In model.losas
        If l.nxGrid > c Then c = l.nxGrid
        If l.nzGrid > c Then c = l.nzGrid
    Next

    setting.PasoGrid = c
    setting.PuntosInterpolados = 2

    Return c

End

Public Sub ListarCargasBarras(Optional iEstado As Integer = -1, iBarra As String = "")

    Dim a As Integer
    Dim b As ClsBarra, c As ClsCargaBarra
    ' lista las cargas para ese estado por consola
    For Each b In model.barra 'a = 0 To cargas model.barra.Max
        For Each c In b.cargas
            ' filtro
            If (c.e = iestado) Or (iEstado < 0) Then
                If (ibarra = "") Or (ibarra = b.handle) Then
                    fmain.debugInfo(" Carga en barra: " & Str(b.handle) & " Estado: " & Str(c.e) & " Tipo: " & Str(c.tipo) &
                        " P: " & Format$(c.px, "0.00") & Format$(c.py, "0.00") & Format$(c.pz, "0.00"))
                Endif
            End If
        Next
    Next

End

Public Sub ListarCargasNudos(estado As Integer)

    Dim a As Integer
    Dim n As ClsNudo
    Dim c As ClsCargaNudo
    ' lista las cargas para ese estado por consola
    For Each n In model.nudo 'a = 0 To cargas model.nudo.Max
        For Each c In n.cargas
            If c.Estado = estado Then
                fmain.debugInfo(" Carga en model.nudos " & Str(n.handle) & " P: " &
                    Format$(c.px, "0.00") & Format$(c.py, "0.00") & Format$(c.pz, "0.00") &
                    " M: " & Format$(c.mx, "0.00") & Format$(c.my, "0.00") & Format$(c.mz, "0.00"))
            Endif
        Next
    Next

End

Public Function FiltroBarra(iBarra As ClsBarra, Optional iSector As Integer = -1, iGrupo As String = "", iTipo As Integer = -1) As Boolean

    If iSector >= 0 Then
        If igrupo <> "" Then
            If ibarra.tipo = e3d.tipo_losa Then
                If model.losas.Exist(ibarra.grupo) Then Return True
            Else If ibarra.tipo = e3d.tipo_viga Then
                If model.vigas.Exist(ibarra.grupo) Then Return True
            Else If ibarra.tipo = e3d.tipo_columna Then
                If model.columna.Exist(ibarra.grupo) Then Return True
            Else If ibarra.tipo = e3d.tipo_tabique Then
                If model.tabiques.Exist(ibarra.grupo) Then Return True
            End If
        End If
    End If

    If (ibarra.tipo <> iTipo) And (iTipo >= 0) Then Return False

    Return True

End

Public Function GetMaterialByHandle(h As String) As ClsMaterial
    ' busca si tengo una seccion rectangular de esas caracteristicas, sino la crea y devuelve el indice

    Dim m As ClsMaterial

    For Each m In material

        If m.handle = h Then Return m

    Next

    Return material[material.First]

End

Public Function GetMaterialByName(name As String) As ClsMaterial
    ' busca si tengo una seccion rectangular de esas caracteristicas, sino la crea y devuelve el indice

    Dim m As ClsMaterial

    For Each m In material

        If m.nombre = name Then Return m

    Next

    Return material[material.First]

End

Public Function GetSeccionByName(name As String) As ClsSeccion
    ' busca si tengo una seccion rectangular de esas caracteristicas, sino la crea y devuelve el indice

    Dim seccu As New ClsSeccion

    For Each seccu In model.secciones

        If seccu.nombre = name Then Return seccu

    Next

    Return model.secciones[model.secciones.First]

End

Public Function GetSeccion(a As Float, b As Float) As ClsSeccion
    ' busca si tengo una seccion rectangular de esas caracteristicas, sino la crea y devuelve el indice

    Dim seccu As ClsSeccion

    For Each seccu In model.secciones

        If (seccu.a = a) And (seccu.b = b) And (seccu.tipo = "G-Rectangular") Then
            'tengo una seccion
            Return seccu

        End If
    Next

    seccu = New ClsSeccion

    seccU.a = a
    seccU.b = b
    seccU.tipo = "G-Rectangular"
    seccU.area = a * b
    seccU.iz = a * b ^ 3 / 12
    seccU.iy = a ^ 3 * b / 12
    seccU.ip = a ^ 3 * b / 12 + a * b ^ 3 / 12
    seccU.wy = a ^ 2 * b / 8
    seccU.wz = a * b ^ 2 / 8
    seccU.nombre = "R" & Format$(a, "0.00") & "x" & Format$(b, "0.00")
    seccu.handle = GetNewHandle()
    model.secciones.Add(seccU, seccU.nombre)

    Return seccu

End

Public Function FiltrarBarras(YaSelecionada As Boolean, Optional tipo As Integer = -1, Optional grupo As Integer = -1, Optional sector As Integer = -1, Optional material As String = "", Optional seccion As String = "") As Integer
    ' pone .seleccionado = True en todas las barras que cumplas las condiciones de los parametros
    '
    'Devuelve el total de barras seleccionadas

    Dim a As Integer, n As Integer

    For Each bar As Clsbarra In model.barra
        If bar.seleccionado Or Not YaSelecionada Then
            bar.seleccionado = True
            If tipo >= 0 And (bar.tipo <> tipo) Then bar.seleccionado = False ' no cumple
            If grupo >= 0 And (bar.grupo <> grupo) Then bar.seleccionado = False ' no cumple
            If material <> "" And (bar.material.nombre <> material) Then bar.seleccionado = False ' no cumple
            If seccion <> "" And (bar.seccion.nombre <> seccion) Then bar.seleccionado = False ' no cumple
            If sector >= 0 And (bar.sector <> sector) Then bar.seleccionado = False ' no cumple

            ' si sigue seleccionada, sumo

            If bar.seleccionado Then n += 1

        Endif
    Next
    Return n

End

Public Sub Esfuerzos_de_Barras_a_Vigas(Modo As Integer)

    'coloco en model.vigas[] los esfuerzos del ultimo calculo, segun Modo
    'Modo=0 -> reemplazo los valores
    'Modo=1 -> comparo y reemplazo la peor condicion
    'Modo=2 -> Sumo los valores
    'Modo=4 -> Sumo solo si empeora la condicion

    Dim b As Clsbarra
    Dim v As ClsViga
    Dim p As Integer
    Dim Inve As Float

    If Not flags.calculado Then
        fmain.debugInfo("No se ha calculado el proyecto aun")
        Return
    Endif

    For Each b In model.barra ' = 1 To  model.barra.Max
        ' busco determino si pertenece a alguna viga
        If b.tipo = tipo_viga Then
            v = GetPosViga(b.grupo)
            inve = 1 'IIf(model.barra[v].Invertida, -1, 1)
            ' comienzo a cargar los esfuerzos
            If modo = 0 Then
                If v.maxN < b.EsfExtBar.maxN * inve Then v.maxN = b.EsfExtBar.maxN * inve
                If v.maxQy < b.EsfExtBar.maxQy * inve Then v.maxQy = b.EsfExtBar.maxQy * inve
                If v.maxQz < b.EsfExtBar.maxQz * inve Then v.maxQz = b.EsfExtBar.maxQz * inve
                If v.maxT < b.EsfExtBar.maxT * inve Then v.maxT = b.EsfExtBar.maxT * inve
                If v.maxMy < b.EsfExtBar.maxMy Then v.maxMy = b.EsfExtBar.maxMy
                If v.maxMz < b.EsfExtBar.maxMz Then v.maxMz = b.EsfExtBar.maxMz

                If v.minN > b.EsfExtBar.minN * inve Then v.minN = b.EsfExtBar.minN * inve
                If v.minQy > b.EsfExtBar.minQy * inve Then v.minQy = b.EsfExtBar.minQy * inve
                If v.minQz > b.EsfExtBar.minQz * inve Then v.minQz = b.EsfExtBar.minQz * inve
                If v.minT > b.EsfExtBar.minT * inve Then v.minT = b.EsfExtBar.minT * inve
                If v.minMy > b.EsfExtBar.minMy Then v.minMy = b.EsfExtBar.minMy
                If v.minMz > b.EsfExtBar.minMz Then v.minMz = b.EsfExtBar.minMz

                ' tengo que ver si la model.barra es un extremo de la viga

                If b.ni = v.nudo1 Then
                    v.niN = b.EsfExtBar.nin * inve
                    v.niQy = b.EsfExtBar.niqy * inve
                    v.niQz = b.EsfExtBar.niqz * inve
                    v.niT = b.EsfExtBar.nit * inve
                    v.niMy = b.EsfExtBar.nimy
                    v.niMz = b.EsfExtBar.nimz
                Else If b.ni = v.nudo2 Then
                    v.nfN = b.EsfExtBar.nin * inve
                    v.nfQy = b.EsfExtBar.niqy * inve
                    v.nfQz = b.EsfExtBar.niqz * inve
                    v.nfT = b.EsfExtBar.nit * inve
                    v.nfMy = b.EsfExtBar.nimy
                    v.nfMz = b.EsfExtBar.nimz
                End If

                If b.nf = v.nudo1 Then
                    v.niN = b.EsfExtBar.nfn * inve
                    v.niQy = b.EsfExtBar.nfqy * inve
                    v.niQz = b.EsfExtBar.nfqz * inve
                    v.niT = b.EsfExtBar.nft * inve
                    v.niMy = b.EsfExtBar.nfmy
                    v.niMz = b.EsfExtBar.nfmz
                Else If b.nf = v.nudo2 Then
                    v.nfN = b.EsfExtBar.nfn * inve
                    v.nfQy = b.EsfExtBar.nfqy * inve
                    v.nfQz = b.EsfExtBar.nfqz * inve
                    v.nfT = b.EsfExtBar.nft * inve
                    v.nfMy = b.EsfExtBar.nfmy
                    v.nfMz = b.EsfExtBar.nfmz
                End If

            End If
        Endif

    Next

End

Public Function GetPosBar(LaViga As Integer, Xv As Float, ByRef LaBarra As Integer, ByRef Xb As Float) As Boolean

    '1 - - - - - - - - - - - - - - - - - - Xv - - - - - - - - - - - - - - - - - - - - - - - -2
    '                                         LaViga

    'i--------1------fi-----2-----fi--------Xb---3----------------fi-------------4--------------f
    '                          barras que forman la viga

    ' en este caso deberia devolver la barra=3 y Xb

    Dim Vbarras As New Integer[]
    Dim Blargos As New Float[]
    Dim Vnudos As New Integer[]

    Dim BarrasOrdenadas As New Integer[]
    Dim LargosOrdenados As New Float[]
    Dim nudoSiguiente As Integer

    Dim b As Integer, LTotal As Float
    Dim a As Integer, v As Integer

    If Xv < 0 Then Return False
    If model.vigas[LaViga].l <= 0 Then Return False

    ' primero buscamos las barras que forman la viga

    For b = 1 To model.barra.Count
        If model.barra[b].grupo = model.vigas[LaViga].grupo Then Vbarras.Add(b)

    Next

    If Vbarras.Count = 0 Then Return False  'no encontre barras que formen la viga

    ' calculo el largo
    For b = 0 To Vbarras.Max
        Blargos.Add(longitud(Vbarras[b]))
        LTotal += Blargos(b)
    Next

    If lTotal <> modAlgebra.Distancia(model.nudo[model.vigas[v].nudo1], model.nudo[model.vigas[v].nudo2]) Then
        ' no coinciden, o hay barras superpuestas
        Stop

    Endif

    ' ordeno las barras, de model.nudo 1 en adelante

    model.nudoSiguiente = model.vigas[LaViga].nudo1
    For a = 0 To Vbarras.Max
        For b = 0 To Vbarras.Max
            If model.barra[Vbarras[b]].ni = model.nudoSiguiente Then
                BarrasOrdenadas.Add(Vbarras[b])
                model.nudoSiguiente = model.barra[Vbarras[b]].nf
                Vbarras.Remove(b) ' para no repetir
                Break
            Else If model.barra[Vbarras[b]].nf = model.nudoSiguiente Then
                BarrasOrdenadas.Add(Vbarras[b])
                model.nudoSiguiente = model.barra[Vbarras[b]].ni
                Vbarras.Remove(b) ' para no repetir
                Break
            Endif
        Next
    Next

    ' aca ya estan ordenadas, entonces busco la seccion

    For a = 0 To BarrasOrdenadas.Max
        If Xv > longitud(model.barrasOrdenadas[a]) Then
            Xv -= longitud(model.barrasOrdenadas[a])
        Else 'encontre la seccion
            LaBarra = BarrasOrdenadas[a]
            Xb = Xv
            Return True
        Endif
    Next

End

Public Sub Esfuerzos_de_Barras_a_Losas(Modo As Integer)

    'coloco en model.vigas[] los esfuerzos del ultimo calculo, segun Modo
    'Modo=0 -> reemplazo los valores
    'Modo=1 -> comparo y reemplazo la peor condicion
    'Modo=2 -> Sumo los valores
    'Modo=4 -> Sumo solo si empeora la condicion

    Dim b As ClsBarra
    Dim L As ClsLosa
    Dim w As Float

    Dim frase As String

    If Not flags.calculado Then
        fmain.debugInfo("No se ha calculado el proyecto aun")
        Return
    Endif

    For Each b In model.barra ' = 1 To  model.barra.Max
        ' busco determino si pertenece a alguna losa
        If b.tipo = tipo_losa Then
            L = model.losas[b.grupo]
            If b.Eje = 1 Then w = L.dzGrid  'se divide por el otro sentido que es lo que representa la barra
            If b.Eje = 2 Then w = L.dxGrid
            If w = 0 Then w = longitud(b) ' es una aproximacion

            ' comienzo a cargar los esfuerzos
            If modo = 0 Then
                If b.Eje = 1 Then ' la model.barra corresponde a la direccion local X en la losa
                    If L.maxQx < (b.EsfExtBar.maxQy / w) Then L.maxQx = b.EsfExtBar.maxQy / w
                    If L.maxMx < (b.EsfExtBar.maxMz / w) Then
                        L.maxMx = b.EsfExtBar.maxMz / w
                        'losas[v].barra_MXmax = b  ' TODO: esto no se para q lo puse
                    End If

                    If L.minQx > (b.EsfExtBar.minQy / w) Then L.minQx = b.EsfExtBar.minQy / w
                    If L.minMx > (b.EsfExtBar.minMz / w) Then
                        L.minMx = b.EsfExtBar.minMz / w
                        'losas[v].barra_MXmin = b
                    End If
                End If

                If L.maxT < b.EsfExtBar.maxT Then L.maxT = b.EsfExtBar.maxT
                If L.minT > b.EsfExtBar.minT Then L.minT = b.EsfExtBar.minT

                If b.eje = 2 Then ' la model.barra corresponde a la direccion local Z en la losa
                    If L.maxQz < (b.EsfExtBar.maxQy / w) Then L.maxQz = b.EsfExtBar.maxQy / w
                    If L.maxMz < (b.EsfExtBar.maxMz / w) Then
                        L.maxMz = b.EsfExtBar.maxMz / w
                        'losas[v].barra_MZmax = b
                    End If
                    If L.minQz > (b.EsfExtBar.minQy / w) Then L.minQz = b.EsfExtBar.minQy / w
                    If L.minMz > (b.EsfExtBar.minMz / w) Then
                        L.minMz = b.EsfExtBar.minMz / w
                        'losas[v].barra_MZmin = b
                    End If
                End If
            Endif

        Endif

    Next

    For Each L In model.losas
        frase = frase & "Losa " & Str(L.numero) & "-" & Str(L.sector) & ":" & gb.Cr
        frase = frase & gb.Tab & "Lx" & Str(L.dxGrid) & gb.Cr
        frase = frase & gb.Tab & "Lz" & Str(L.dzGrid) & gb.Cr

        frase = frase & gb.Tab & "Mz min: " & Format(L.minMz, setting.formato) & " en model.barra " & Str(L.barra_MZmin) & gb.Cr

        fmain.debugInfo(frase)
        frase = ""

    Next

End

Public Sub Esfuerzos_de_Barras_a_Losas_en_Extremos(Modo As Integer)

    ' la diferencia conrespecto a la version 1 es que utilizo la posicion de la model.barra para ver en que parte estoy de la losa

    'coloco en model.vigas[] los esfuerzos del ultimo calculo, segun Modo
    'Modo=0 -> reemplazo los valores
    'Modo=1 -> comparo y reemplazo la peor condicion
    'Modo=2 -> Sumo los valores
    'Modo=4 -> Sumo solo si empeora la condicion

    Dim b As ClsBarra
    Dim v As ClsLosa
    Dim w As Float

    'variables de maximos
    Dim barra_MXmax As Integer
    Dim barra_MZmax As Integer
    Dim barra_MXmin As Integer
    Dim barra_MZmin As Integer

    Dim frase As String

    If Not flags.calculado Then
        fmain.debugInfo("No se ha calculado el proyecto aun")
        Return
    Endif

    For Each b In model.barra ' = 1 To  model.barra.Max
        ' busco determino si pertenece a alguna viga
        If b.tipo = tipo_losa Then
            v = model.losas[b.grupo]
            If b.Eje = 1 Then w = v.dzGrid
            If b.Eje = 2 Then w = v.dxGrid

            If w = 0 Then w = longitud(b) ' es una aproximacion

            ' comienzo a cargar los esfuerzos
            If modo = 0 Then

                If b.Eje = 1 Then ' la model.barra corresponde a la direccion local X en la losa
                    If v.maxQx < (b.EsfExtBar.maxQy / w) Then v.maxQx = b.EsfExtBar.maxQy / w
                    If v.maxMx < (b.EsfExtBar.maxMz / w) Then
                        v.maxMx = b.EsfExtBar.maxMz / w
                        v.barra_MXmax = b
                    End If

                    If v.minQx > (b.EsfExtBar.minQy / w) Then v.minQx = b.EsfExtBar.minQy / w
                    If v.minMx > (b.EsfExtBar.minMz / w) Then
                        v.minMx = b.EsfExtBar.minMz / w
                        v.barra_MXmin = b
                    End If
                End If

                If v.maxT < b.EsfExtBar.maxT Then v.maxT = b.EsfExtBar.maxT
                If v.minT > b.EsfExtBar.minT Then v.minT = b.EsfExtBar.minT

                If model.barra[b].eje = 2 Then ' la model.barra corresponde a la direccion local Z en la losa
                    If v.maxQz < (b.EsfExtBar.maxQy / w) Then v.maxQz = b.EsfExtBar.maxQy / w
                    If v.maxMz < (b.EsfExtBar.maxMz / w) Then
                        v.maxMz = b.EsfExtBar.maxMz / w
                        v.barra_MZmax = b
                    End If
                    If v.minQz > (b.EsfExtBar.minQy / w) Then v.minQz = b.EsfExtBar.minQy / w
                    If v.minMz > (b.EsfExtBar.minMz / w) Then
                        v.minMz = b.EsfExtBar.minMz / w
                        v.barra_MZmin = b
                    End If
                End If

            End If
        Endif

    Next

End

Public Function GetPosViga(grupo As String) As ClsViga

    Dim v As ClsViga

    For Each v In model.vigas
        If (v.Handle = grupo) Then Return v
    Next
    Return Null

End

Public Function GetPosLosa(grupo As String) As ClsLosa

    Dim l As ClsLosa

    For Each l In model.losas
        If (l.Handle = grupo) Then Return l
    Next
    Return Null

End

Public Function GetNodeHandle(iIndex As Integer) As String

    For Each n As ClsNudo In model.nudo
        If n.indice = iIndex Then Return n.handle
    Next

End

Public Function NewGrupo() As Integer

    Inc model.datos.TotalGrupos

    Return model.datos.TotalGrupos

End

Public Sub Form_Open()

    Dim a As Integer

    fmain.debuginfo(("Abriendo Informacion"))
    ' lleno los datos del combo
    cmbtipo.Add(("Reticulado Plano"))
    cmbtipo.Add(("Reticulado Espacial"))
    cmbtipo.Add(("Portico Plano"))
    cmbtipo.Add(("Portico Espacial"))

    cmbLong.add(("metr"))
    cmbLong.add(("cent"))
    cmbLong.add(("inch"))
    cmbLong.add(("feet"))

    cmbFuerza.add(("tons"))
    cmbFuerza.add(("kilo"))
    cmbFuerza.add(("pndf"))
    cmbFuerza.add(("knwt"))

    cmbAngulo.add(("rads"))
    cmbAngulo.add(("grad"))

    cmbLong.index = 0
    cmbFuerza.index = 1
    cmbAngulo.index = 0

    txtdesc.Text = e3d.model.datos.descripcion

    lblProyecto.Text = e3d.model.datos.proyecto
    txtNudos.Text = Format$(e3d.model.nudo.Count, "0")
    txtBarras.Text = Format$(e3d.model.barra.Count, "0")

    If e3d.model.datos.tipo = 1 Then cmbtipo.Index = 0  'reticulado plano
    If e3d.model.datos.tipo = 2 Then cmbtipo.Index = 1  'reticulado espacial
    If e3d.model.datos.tipo = 3 Then cmbtipo.Index = 2  'portico plano
    If e3d.model.datos.tipo = 4 Then cmbtipo.Index = 3  'portico espacial

    ' pongo las unidades que correspondan en los combos
    For a = 0 To cmbLong.Count - 1
        If cmbLong[a].Text = e3d.model.datos.unidades.long_nombre Then cmbLong.Index = a

    Next
    For a = 0 To cmbFuerza.Count - 1
        If cmbFuerza[a].Text = e3d.model.datos.unidades.peso_nombre Then cmbFuerza.Index = a

    Next

    If e3d.model.datos.unidades.ang_nombre = "rads" Then cmbAngulo.Index = 0 Else cmbAngulo.Index = 1

End

Public Sub btnCancel_Click()

    FMain.SetStatus
    fmain.debuginfo(("Cerrando Informacion"))
    Me.Close

End

Public Sub btnAceptar_Click()

    Dim t As Integer, a As Integer
    'On Error GoTo aca_no_hay_mamoria:

    t = Val(txtNudos.Text)

    ' redimensiono los arrays
    If t > e3d.model.nudo.Count Then

        ' intento agregar los model.nudos
        For a = 1 To (t - e3d.model.nudo.Count)
            e3d.addnudo(0, 0, 0, False)
        Next

    Else If t < e3d.model.nudo.count Then

        If Message.Question(("Se van a eliminar ") & Str$(e3d.model.nudo.Count - t) & (" model.nudos, sus correspondientes apoyos y cargas, ¿esta seguro?"), ("Eliminar"), ("Cancelar")) = 1 Then
            'elimino nomas
            '
            ' intento eliminar los model.nudos
            For a = 1 To (e3d.model.nudo.Count - t)
                e3d.model.nudo.Remove(e3d.model.nudo.Last)
            Next

        Endif

    End If

    t = Val(txtbarras.Text)

    ' redimensiono los arrays
    If t > e3d.model.barra.Count Then

        ' intento agregar los model.nudos
        For a = 1 To (t - e3d.model.barra.Count)
            e3d.AddBarra(0, 0)
        Next

    Else If t < e3d.model.barra.Count Then

        If Message.Question(("Se van a eliminar ") & Str$(e3d.model.barra.Count - t) & (" barras y sus correspondientes cargas, ¿esta seguro?"), ("Eliminar"), ("Cancelar")) = 1 Then
            'elimino nomas
            '
            e3d.model.barra.Count = t

        Endif

    End If

    ' pongo las unidades que correspondan en los datos

    e3d.model.datos.unidades.long_nombre = cmbLong.text

    e3d.model.datos.unidades.peso_nombre = cmbFuerza.text

    e3d.model.datos.unidades.ang_nombre = cmbAngulo.text

    e3d.calcular_factores

    'e3d.DoEvents

    e3d.model.datos.tipo = cmbtipo.Index + 1

    e3d.model.datos.descripcion = txtdesc.Text

    e3d.flags.cambios = True
    ' y tiene que recalcular
    e3d.flags.calculado = False
    FMain.SetStatus
    Me.close

End

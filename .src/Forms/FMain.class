Public Sub vistaFrontal()

    'me ubico al frente
    glCam.Position.x = grf.cgX
    glCam.Position.y = grf.cgy
    glCam.Position.z = grf.cgz + 2 * grf.maxmax

    'miro hacia el -Z
    glCam.ViewDir.x = 0
    glCam.ViewDir.y = 0
    glCam.ViewDir.z = -1

    'mi cabeza apunta al +Y

    glCam.UpVector.x = 0
    glCam.UpVector.y = 1
    glCam.UpVector.z = 0

    $hDrawTimer.trigger  'Paint3D.Redraw

End

Public Sub vistaSuperior()

    'estoy arriba de la estructura, mirando hacia abajo

    glCam.Position.x = grf.cgX
    glCam.Position.y = grf.cgy + 2 * grf.maxmax
    glCam.Position.z = grf.cgz

    glCam.ViewDir.x = 0
    glCam.ViewDir.y = -1
    glCam.ViewDir.z = 0

    'mi cabeza apunta al -Z

    glCam.UpVector.x = 0
    glCam.UpVector.y = 0
    glCam.UpVector.z = -1

    $hDrawTimer.trigger 'grf.dibujar_estructura3D

End

Public Sub vistaLateral()

    'me ubico a la derecha
    glCam.Position.x = grf.cgX + 2 * grf.maxmax
    glCam.Position.y = grf.cgy
    glCam.Position.z = grf.cgz

    'miro hacia el -X
    glCam.ViewDir.x = -1
    glCam.ViewDir.y = 0
    glCam.ViewDir.z = 0

    'mi cabeza apunta al +Y

    glCam.UpVector.x = 0
    glCam.UpVector.y = 1
    glCam.UpVector.z = 0

    $hDrawTimer.trigger  'Paint3D.Redraw

End

Public Sub vistaIsometrica()

    'me ubico al frente/derecha
    glCam.Position.x = grf.cgX + 1.5 * grf.maxmax
    glCam.Position.y = grf.cgy
    glCam.Position.z = grf.cgz + 1.5 * grf.maxmax

    'miro hacia el -XZ
    glCam.ViewDir.x = -1
    glCam.ViewDir.y = 0
    glCam.ViewDir.z = -1

    'mi cabeza apunta al +Y

    glCam.UpVector.x = 0
    glCam.UpVector.y = 1
    glCam.UpVector.z = 0

    $hDrawTimer.trigger  'Paint3D.Redraw

End


    If e3d.model.graficos.DibujarDetalles = False Then 'no los he dibjado

        e3d.model.graficos.DibujarDetalles = True
        '$hDrawTimer.trigger
    Else
        'los estoy dibujando

    End If

    '$hDrawTimer.Trigger

    e3d.model.graficos.DibujarDetalles = True

End

Public Sub Form_KeyPress()

    If Key.code = Key.Esc Then
        If e3d.flags.calculando Then
            e3d.flags.parar_calculos = True
            clc.para = -1
        End If
    End If

    If Key.code = Key.Enter Then

        If e3d.flags.CalculandoEnvolventes Then
            e3d.envolventes.tiempo_minimo = 0

        End If
    End If

    If Key.code = Key.Space Then
        If e3d.flags.Pausa = True Then e3d.flags.Pausa = False Else e3d.flags.pausa = True

    End If

    If Key.Code = Key.PgUp Then
        glCam.RotateY(1) '.straferight(grf.Escala / 100)
        $hDrawTimer.trigger
    End If

    If Key.Code = Key.PgDown Then
        glCam.RotateY(-1) '.straferight(grf.Escala / 100)
        $hDrawTimer.trigger
    End If

    If Key.Code = Key.Home Then
        glCam.RotateX(1) '.straferight(grf.Escala / 100)
        $hDrawTimer.trigger
    End If

    If Key.Code = Key.End Then
        glCam.RotateX(-1) '.straferight(grf.Escala / 100)
        $hDrawTimer.trigger
    End If

    If Key.Code = Key.Up Then
        grf.Pan.y -= grf.maxmax / 20

        $hDrawTimer.trigger
    End If

    If Key.Code = Key.Down Then
        grf.Pan.y += grf.maxmax / 20

        $hDrawTimer.trigger
    End If

    If Key.Code = Key.Right Then
        grf.Pan.x -= grf.maxmax / 20

        $hDrawTimer.trigger
    End If

    If Key.Code = Key.Left Then
        grf.Pan.x += grf.maxmax / 20

        $hDrawTimer.trigger
    End If

    ' If Key.Code = Key.Home Then
    '      grf.Pan.z -= grf.maxmax / 20
    '
    '      $hDrawTimer.trigger
    '  End If
    '
    '  If Key.Code = Key.End Then
    '      grf.Pan.z += grf.maxmax / 20
    '
    '      $hDrawTimer.trigger
    '  End If

End


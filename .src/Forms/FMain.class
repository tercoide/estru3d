Public Sub btnAumentarEscala2_Click()

    Select Case Trim$(e3d.model.graficos.ultimo)
        Case "e"
            e3d.model.graficos.FactorFlecha = e3d.model.graficos.FactorFlecha * 2
            gl.DeleteLists(grf.glListaE, 1)
            grf.glListae = gl.GenLists(1)

            gl.NewList(grf.glListae, gl.COMPILE)
            grf.DibujarElastica()
            gl.EndList
        Case "mz"
            e3d.model.graficos.ESCmz = e3d.model.graficos.ESCmz * 2
            gl.DeleteLists(grf.glListaMz, 1)
            grf.glListaMz = gl.GenLists(1)

            gl.NewList(grf.glListaMz, gl.COMPILE)
            grf.DibujarEsfuerzos(grf.Mz)
            gl.EndList

        Case "qy"
            e3d.model.graficos.ESCqy = e3d.model.graficos.ESCqy * 2
            gl.DeleteLists(grf.glListaQy, 1)
            grf.glListaQy = gl.GenLists(1)
            gl.NewList(grf.glListaQy, gl.COMPILE)
            grf.DibujarEsfuerzos(grf.Qy)
            gl.EndList
        Case "n"
            e3d.model.graficos.ESCn = e3d.model.graficos.ESCn * 2
            gl.DeleteLists(grf.glListaN, 1)
            grf.glListaN = gl.GenLists(1)

            gl.NewList(grf.glListaN, gl.COMPILE)
            grf.DibujarEsfuerzos(grf.N)
            gl.EndList
        Case "my"
            e3d.model.graficos.ESCmy = e3d.model.graficos.ESCmy * 2
            gl.DeleteLists(grf.glListaMy, 1)
            grf.glListaMy = gl.GenLists(1)

            gl.NewList(grf.glListaMy, gl.COMPILE)
            grf.DibujarEsfuerzos(grf.My)
            gl.EndList
        Case "qz"
            e3d.model.graficos.ESCqz = e3d.model.graficos.ESCqz * 2
            gl.DeleteLists(grf.glListaQz, 1)
            grf.glListaQz = gl.GenLists(1)

            gl.NewList(grf.glListaQz, gl.COMPILE)
            grf.DibujarEsfuerzos(grf.Qz)
            gl.EndList
        Case "t"
            e3d.model.graficos.ESCt = e3d.model.graficos.ESCt * 2
            gl.DeleteLists(grf.glListaT, 1)
            grf.glListaT = gl.GenLists(1)

            gl.NewList(grf.glListaT, gl.COMPILE)
            grf.DibujarEsfuerzos(grf.T)
            gl.EndList

    End Select

    $hDrawTimer.trigger

End

Public Sub btnReducirEscala2_Click()

    Select Case Trim$(e3d.model.graficos.ultimo)
        Case "e"
            e3d.model.graficos.FactorFlecha = e3d.model.graficos.FactorFlecha / 2
            gl.DeleteLists(grf.glListaE, 1)
            grf.glListae = gl.GenLists(1)

            gl.NewList(grf.glListae, gl.COMPILE)
            grf.DibujarElastica()
            gl.EndList
        Case "mz"
            e3d.model.graficos.ESCmz = e3d.model.graficos.ESCmz / 2
            gl.DeleteLists(grf.glListaMz, 1)
            grf.glListaMz = gl.GenLists(1)
            gl.NewList(grf.glListaMz, gl.COMPILE)
            grf.DibujarEsfuerzos(grf.Mz)

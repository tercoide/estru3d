Public Sub abrirProyecto(Optional archivo As String = "")

    ' Abrir dialogo para abrir proyecto
    Dim a As Integer, loTengo As Integer

    If e3d.flags.cambios Then
        If Message.Warning(("¿Desea guardar los cambios en el proyecto?"), ("Guardar"), ("Descartar")) = 0 Then
            ' mando a guardar
            guardarProyecto
        End If
    End If

    abro_o_guardo = 1 ' abro  TODO: hay informacion redundante, necesitamos simpllificar esto

    If archivo = "" Then

        Dialog.Title = ("Select File")

        Dialog.Filter = ["*.ce5;*.estru3D", "Estructuras"]
        Dialog.Path = Config.FilesLastPath
        Dialog.OpenFile(False)
        e3d.a_abrir = Dialog.Path
        '
    Else

        e3d.a_abrir = archivo
    End If

    e3d.PonerEnCero()
    e3d.flags.dibujable = False
    If LCase(Right(archivo, "4")) = ".ce5" Then
        If e3d.cargar5(e3d.a_abrir) <> True Then
            message.Warning(("Error al cargar el proyecto"))
            'menu_nuevo_click
            'Exit Sub
        End If
    Else
        If e3d.cargar6(e3d.a_abrir) <> True Then
            message.Warning(("Error al cargar el proyecto"))
            'menu_nuevo_click
            'Exit Sub
        End If

    End If
    e3d.model.datos.proyecto = e3d.a_abrir

    e3d.ZOOMED = False
    ' armo todas las combinaciones

    clc.combinar()
    graficar

    e3d.flags.calculado = False
    e3d.model.graficos.cambios = True

    SetStatus

    ' reacomodo los Recientes, de maanera SIMPLE

    ' primero veo si lo tengo
    loTengo = False
    If e3d.a_abrir = mnuReciente1.text Then loTengo = 1
    If e3d.a_abrir = mnuReciente2.text Then loTengo = 2
    If e3d.a_abrir = mnuReciente3.text Then loTengo = 3
    If e3d.a_abrir = mnuReciente4.text Then loTengo = 4
    If e3d.a_abrir = mnuReciente5.text Then loTengo = 5

    If Not lotengo Then
        ' desplazo todos los recientes hacia abajo
        e3d.setting.lastopen5 = e3d.setting.lastopen4
        e3d.setting.lastopen4 = e3d.setting.lastopen3
        e3d.setting.lastopen3 = e3d.setting.lastopen2
        e3d.setting.lastopen2 = e3d.setting.lastopen1
        e3d.setting.lastopen1 = e3d.a_abrir

        GuardarParametros
        LeerRecientes

    End If
    e3d.a_abrir = ""

End

Public Sub guardarProyecto()

    Dim a_guardar As String, ok As Integer

    If e3d.model.datos.proyecto = "" Or InStr(UCase$(e3d.model.datos.proyecto), "/CALCULO1.CE5") > 0 Then

        Dialog.Title = ("Guardar fichero de Estructura")

        Dialog.Filter = ["*.estru3d", ("Estructuras de Estru3d")]

        Dialog.SaveFile()

        If Dialog.Path = "" Then Return

        a_guardar = Dialog.Path

        If LCase$(Right$(a_guardar, 8)) <> ".estru3d" Then a_guardar &= ".estru3d"
        If a_guardar <> "" Then
            ' veo si sobreescribe
            If Exist(a_guardar) Then
                If message.Warning(("El archivo ya existe, ¿desea sobreescribirlo?"), ("Aceptar"), ("Cancelar")) = 2 Then Return
            End If
            ok = e3d.grabar(a_guardar)

            Select Case ok
                Case True
                    e3d.model.datos.proyecto = a_guardar
                    Me.Caption = ("Proyecto: ") & e3d.model.datos.proyecto
                    e3d.flags.cambios = False
                Case 61
                    Message.Warning(("El disco esta lleno."))
                Case Else
                    Message(("Error inesperado,codigo: ") & ok)
            End Select
        End If
    Else
        ok = e3d.grabar(e3d.model.datos.proyecto)
        Select Case ok
            Case True
                e3d.flags.cambios = False
            Case 61
                Message.Warning(("El disco esta lleno."))
            Case Else
                Message(("Error inesperado,codigo: ") & ok)
        End Select

    End If

    SetStatus

End


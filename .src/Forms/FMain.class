Public Sub Separator6_MouseUp()

    mouDown = False
    mouDownY = 0
    txtDebug.EnsureVisible
    grf.valoresdelgrafico3D  'para que recalcule las escalas

    $hDrawTimer.trigger 'ahora dibujamos

End


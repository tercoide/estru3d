Public Sub LeerRecientes()

    'TODO esto deberia estar en un ini
    ' obtengo los lastopen

    e3d.setting.lastopen1 = e3d.parametros["Files/LastOpen1", ""]
    e3d.setting.lastopen2 = e3d.parametros["Files/LastOpen2", ""]
    e3d.setting.lastopen3 = e3d.parametros["Files/LastOpen3", ""]
    e3d.setting.lastopen4 = e3d.parametros["Files/LastOpen4", ""]
    e3d.setting.lastopen5 = e3d.parametros["Files/LastOpen5", ""]

    If Exist(e3d.setting.lastopen1) Then

        mnuReciente1.Text = e3d.setting.lastopen1
        mnuReciente1.Visible = True
        sep4.Visible = True

    Else
        mnuReciente1.Visible = 0
        sep4.Visible = 0
        e3d.setting.lastopen1 = ""
    End If
    If Exist(e3d.setting.lastopen2) Then
        mnuReciente2.Text = e3d.setting.lastopen2
        mnuReciente2.Visible = True

    Else
        mnuReciente2.Visible = 0
        e3d.setting.lastopen2 = ""

    End If
    If Exist(e3d.setting.lastopen3) Then
        mnuReciente3.Text = e3d.setting.lastopen3
        mnuReciente3.Visible = True

    Else
        mnuReciente3.Visible = 0
        e3d.setting.lastopen3 = ""

    End If

    If Exist(e3d.setting.lastopen4) Then
        mnuReciente4.Text = e3d.setting.lastopen4
        mnuReciente4.Visible = True

    Else
        mnuReciente4.Visible = 0
        e3d.setting.lastopen4 = ""

    End If

    If Exist(e3d.setting.lastopen5) Then
        mnuReciente5.Text = e3d.setting.lastopen5
        mnuReciente5.Visible = True

    Else
        mnuReciente5.Visible = 0
        e3d.setting.lastopen5 = ""

    End If

End

Public Sub GuardarParametros()

    If e3d.setting.lastopen1 <> "" Then e3d.parametros["Files/LastOpen1"] = e3d.setting.lastopen1
    If e3d.setting.lastopen2 <> "" Then e3d.parametros["Files/LastOpen2"] = e3d.setting.lastopen2
    If e3d.setting.lastopen3 <> "" Then e3d.parametros["Files/LastOpen3"] = e3d.setting.lastopen3
    If e3d.setting.lastopen4 <> "" Then e3d.parametros["Files/LastOpen4"] = e3d.setting.lastopen4
    If e3d.setting.lastopen5 <> "" Then e3d.parametros["Files/LastOpen5"] = e3d.setting.lastopen5

    'e3d.Parametros.Save

End


Public Sub GLAreaRender_Resize()

    If Not glx.Initialized Then glx.Init(Render)
    glx.Resize(Render)

    Debug "GLAreaRender resized"

End

Public Sub gestru_Resize()

    If Not glx.Initialized Then glx.Init(gestru)
    glx.Resize(gestru)

    grf.EscalaGL = 1 / gestru.w

    glx.ClearColor(Config.ModelBackgroundColor)

    gl.Enable(gl.DEPTH_TEST)
    gl.Enable(gl.SMOOTH)

    '$hDrawTimer.trigger
    Debug "Gestru resized"

End

Public Sub gestru_MouseDown()

    GLCam.MouseDown

End

Public Sub gestru_MouseMove()

    GLCam.MouseMove

    'debugInfo("Mouse searching at " & Str(Mouse.x) & ":" & Str(gestru.H - Mouse.y))

    barHovered = MouseTracking.CheckAboveEntity(Mouse.x, gestru.H - Mouse.y)

    $hDrawTimer.Trigger

End

Public Sub gestru_MouseUp()

    If barHovered Then
        If e3d.model.Selection.Exist(barHovered.handle) Then ' la desselecciono
            e3d.model.Selection.Remove(barHovered.handle)
        Else
            e3d.model.Selection.Add(barHovered, barHovered.handle)
        End If
    Endif

    $hDrawTimer.trigger

End

Public Sub mnuProyectoSalir_Click()

    Dim ret As Integer
    ' en todos los casos, aprovecho para guardar los parametros
    '
    GuardarParametros
    Config.Save()

    $saliendo = True
    If e3d.flags.cambios Then
        ret = Message.Question(("¿Desea guardar los cambios en el proyecto?"), ("Guardar y cerrar"), ("Cerrar sin guardar"), ("Cancelar"))
        Select Case ret
            Case 1
                ' guarda y cierra
                guardarProyecto
                'hlog(("Cerrando el programa"))
                e3d.closelog
                e3d.PonerEnCero
                Me.Close

            Case 2
                ' no guarda cambios
                'hlog(("Cerrando el programa sin guardar"))
                e3d.closelog
                e3d.PonerEnCero
                Me.Close

            Case Else
                Return
        End Select
    Else
        ' no hay cambios asi que no pregunta
        ''hlog(("Cerrando el programa"))
        e3d.closelog
        e3d.PonerEnCero
        Me.Close
    End If

End


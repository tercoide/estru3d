Public Sub asistente_EliminarBarrasNNV()

    Dim a As Integer, e As Integer, e2 As Integer

    For e = 1 To e3d.model.barra.Count
        If (e3d.model.barra[e].ni > e3d.model.nudo.max) Or (e3d.model.barra[e].nF > e3d.model.nudo.max) Then
            e2 = e2 + 1
            ' deberia Grabar
            e3d.flags.cambios = True
            ' y tiene que recalcular
            e3d.flags.calculado = False

            SetStatus
            e3d.EliminarBarra(e)

        End If
    Next
    message.Info(Subst$(("Se eliminaron &1 barras con model.nudos no válidos."), e2))

    If e3d.flags.cambios Then
        grf.GenerarGrafico
        $hDrawTimer.trigger
    End If

End


Public Sub Form_Activate()

    If Not Activated Then
        gestru = New GLArea(PanelGlModel) As "gestru"

        gestru.Expand = True
        gestru.Tracking = True
        gestru.Mouse = Cursor.CrossHair

        gestru.Background = Color.Black
        gestru.Foreground = Color.White

        Activated = True

    Endif

End


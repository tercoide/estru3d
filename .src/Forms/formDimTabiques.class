' Gambas class file

Public Sub Form_Open()

    ' lleno las tablas

    Dim a As Integer

    tab.Count = 3
    tab[0].Text = ("Parametros")
    ' tab[1].Text = ("Esfuerzos")
    ' tab[2].Text = ("Armadura")

    tblTabiques.rows = 11 ' TODO fix for more

    tblTabiques.cols = 10

    tblTabiques.Header = GridView.Horizontal

    tblTabiques.Columns(0, "Nro")
    tblTabiques.Columns(1, "No",,, Align.Center, "0")
    tblTabiques.Columns(0, "Piso",,, Align.Center, "0")
    tblTabiques.Columns(2, "l",,, Align.Right)
    tblTabiques.Columns(3, "h",,, Align.Right)
    tblTabiques.Columns(4, "esp",,, Align.Right)
    tblTabiques.Columns(5, "pp",,, Align.Right)
    tblTabiques.Columns(6, "g",,, Align.Right)
    tblTabiques.Columns(7, "p",,, Align.Right)
    tblTabiques.Columns(8, "q",,, Align.Right, "0.000")
    tblTabiques.Columns(9, "aux",,, Align.Right)

    llenartabla

End

Public Sub form_Resize()

    tab.top = 0
    tab.Left = 0
    tab.w = Me.W
    'tab.h = btnSalir.top - 6
    btnSalir.top = Me.h - btnSalir.h * 1.5
    btnSalir.Left = Me.w - btnSalir.w * 1.5
    lblInfo.Top = btnSalir.Top
    lblInfo.w = btnSalir.Left - lblInfo.Left

    tblTabiques.top = tab.top + tab.h

    tblTabiques.Left = tab.Left
    tblTabiques.Height = btnSalir.top - tblTabiques.top * 2
    tblTabiques.Width = Me.Width - tblTabiques.Left * 2

End

Public Sub btnSalir_Click()

    Me.Close(0)

End

Sub llenartabla()

    Dim n As Integer

    tblTabiques.rows = modestru.Tabiques.Count

    For n = 0 To modestru.Tabiques.Max
        If tab.Index = 0 Then
            tblTabiques.Cell(n, 0, modestru.Tabiques[n].piso)
            tblTabiques.Cell(n, 1, modestru.Tabiques[n].numero)
            tblTabiques.Cell(n, 2, Format$(modAlgebra.Distancia(modestru.nudo[modestru.Tabiques[n].Nudo1], modestru.nudo[modestru.Tabiques[n].Nudo2]), "0.00")) 'lx
            tblTabiques.Cell(n, 3, Format(modAlgebra.Distancia(modestru.nudo[modestru.Tabiques[n].Nudo3], modestru.nudo[modestru.Tabiques[n].Nudo1]), "0.00")) 'lz
            tblTabiques.Cell(n, 4, Format$(modestru.Tabiques[n].d, "0.00"))
            tblTabiques.Cell(n, 5, Format$(modestru.Tabiques[n].d * modestru.tabiques[n].material.densidad, modestru.setting.formato_datos))
            tblTabiques.Cell(n, 6, Format$(modestru.Tabiques[n].g, modestru.setting.formato_datos))
            tblTabiques.Cell(n, 7, Format$(modestru.Tabiques[n].p, modestru.setting.formato_datos))
            tblTabiques.Cell(n, 8, "=F" & Str$(n + 1) & "+G" & Str$(n + 1) & "+H" & Str$(n + 1))

        End If
    Next
    tblTabiques.Recalcular

End

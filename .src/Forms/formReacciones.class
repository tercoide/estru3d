Public Sub Form_open()

    RellenaDatos()

    cargacombobox()
    ComboBoxFormato.text = "0.00E00"

End Sub

Public Sub aceptar2_Click()

    formReacciones.Close

End

Public Sub ButtonCopiaPortapapeles_Click() ''el contenido del formulario lo paso al portapapeles

    utils.copiaraportapapeles(grdreacciones)

End

Private Sub cargacombobox()

    comboboxformato.clear()
    ComboBoxFormato.Add("0.00E00")
    ComboBoxFormato.Add("0.00")
    ComboBoxFormato.Add("0.0000")
    ComboBoxFormato.Add(e3d.setting.formato_datos)
    ComboBoxFormato.ReadOnly = True

End

Public Sub ComboBoxFormato_Click()

    e3d.setting.formato = comboboxformato.text
    RellenaDatos()

End

Private Sub RellenaDatos()
    ' no esta del todo preparado para porticos espaciales

    Dim a As Integer

    'logear "Abriendo Reacciones"
    grdreacciones.Columns.Count = 10

    grdreacciones.Columns[0].Title = "Nº"
    grdreacciones.Columns[1].title = "X"
    grdreacciones.Columns[2].title = "Y"
    grdreacciones.Columns[3].title = "Z"
    grdreacciones.Columns[4].title = "Rx"
    grdreacciones.Columns[5].title = "Ry"
    grdreacciones.Columns[6].title = "Rz"
    grdreacciones.Columns[7].title = "Mx"
    grdreacciones.Columns[8].title = "My"
    grdreacciones.Columns[9].title = "Mz"

    a = 0
    For Each nudo1 As ClsNudo In e3d.model.nudo
        If IsNull(nudo1.apoyo) Then Continue

        grdreacciones.Rows.Count += 1

        grdreacciones[a, 0].text = Str$(nudo1.indice)
        grdreacciones[a, 1].text = Format(nudo1.x, e3d.setting.formato_datos)
        grdreacciones[a, 2].text = Format(nudo1.Y, e3d.setting.formato_datos)
        grdreacciones[a, 3].text = Format(nudo1.z, e3d.setting.formato_datos)

        Select Case e3d.model.datos.tipo
            Case e3d.reticuladoplano
                grdreacciones[a, 4].text = Format(nudo1.apoyo.ReacFx, e3d.setting.formato)
                grdreacciones[a, 5].text = Format(nudo1.apoyo.ReacFy, e3d.setting.formato)
            Case e3d.porticoplano
                grdreacciones[a, 4].text = Format(nudo1.apoyo.ReacFx, e3d.setting.formato)
                grdreacciones[a, 5].text = Format(nudo1.apoyo.ReacFy, e3d.setting.formato)
                grdreacciones[a, 9].text = Format(nudo1.apoyo.ReacMz, e3d.setting.formato)
            Case e3d.reticuladoespacial
                grdreacciones[a, 4].text = Format(nudo1.apoyo.ReacFx, e3d.setting.formato)
                grdreacciones[a, 5].text = Format(nudo1.apoyo.ReacFy, e3d.setting.formato)
                grdreacciones[a, 6].text = Format(nudo1.apoyo.ReacFz, e3d.setting.formato)
            Case e3d.porticoespacial

                grdreacciones[a, 4].text = Format(nudo1.apoyo.ReacFx, e3d.setting.formato)
                grdreacciones[a, 5].text = Format(nudo1.apoyo.ReacFy, e3d.setting.formato)
                grdreacciones[a, 6].text = Format(nudo1.apoyo.ReacFz, e3d.setting.formato)

                grdreacciones[a, 7].text = Format(nudo1.apoyo.ReacMx, e3d.setting.formato)
                grdreacciones[a, 8].text = Format(nudo1.apoyo.ReacMy, e3d.setting.formato)
                grdreacciones[a, 9].text = Format(nudo1.apoyo.ReacMz, e3d.setting.formato)

        End Select
        Inc a

    Next

End

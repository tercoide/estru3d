Public Sub btnCalcular_Click()

    ' algunas variables utiles

    If chkSuperponerEstadoActual.Value <> 0 Then e3d.envolventes.Estado = e3d.flags.Estado Else e3d.envolventes.Estado = 0

    If chkGraficar.Value <> 0 Then e3d.envolventes.tiempo_minimo = Val(txtSegundos.Text) Else e3d.envolventes.tiempo_minimo = 0

    Me.Hide

    clc.IniciarCalculosEnvolventes

    'Me.Close

end
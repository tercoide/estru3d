' Gambas class file

Public Sub Form_Open()

    ' lleno las tablas

    Dim a As Integer

    tabStrip1.Count = 3
    tabStrip1[0].Text = ("Parametros")
    ' tab[1].Text = ("Esfuerzos")
    ' tab[2].Text = ("Armadura")

    tbllosas.rows = 11 ' TODO fix for more

    tbllosas.cols = 10

    tbllosas.Header = GridView.Horizontal

    tbllosas.Columns(0, "Nro")
    tbllosas.Columns(1, "No",,, Align.Center, "0")
    tbllosas.Columns(0, "Piso",,, Align.Center, "0")
    tbllosas.Columns(2, "lx",,, Align.Right)
    tbllosas.Columns(3, "lz",,, Align.Right)
    tbllosas.Columns(4, "esp",,, Align.Right)
    tbllosas.Columns(5, "pp",,, Align.Right)
    tbllosas.Columns(6, "g",,, Align.Right)
    tbllosas.Columns(7, "p",,, Align.Right)
    tbllosas.Columns(8, "q",,, Align.Right, "0.000")
    tbllosas.Columns(9, "aux",,, Align.Right)

    llenartabla
    llenarEsfuerzos

End

Public Sub btnSalir_Click()

    Me.Close(0)

End

Sub llenartabla()

    Dim n As Integer

    tbllosas.rows = e3d.model.losas.Count
    tblEsfuerzos.cols = 10

    For n = 0 To e3d.model.losas.Max
        If tabStrip1.Index = 0 Then
            tbllosas.Cell(n, 0, e3d.model.losas[n].sector)
            tbllosas.Cell(n, 1, e3d.model.losas[n].numero)
            tbllosas.Cell(n, 2, Format$(modAlgebra.Distancia(e3d.model.nudo[e3d.model.losas[n].Nudo1].xyz, e3d.model.nudo[e3d.model.losas[n].Nudo2].xyz), "0.00")) 'lx
            tbllosas.Cell(n, 3, Format(modAlgebra.Distancia(e3d.model.nudo[e3d.model.losas[n].Nudo3].xyz, e3d.model.nudo[e3d.model.losas[n].Nudo1].xyz), "0.00")) 'lz
            tbllosas.Cell(n, 4, Format$(e3d.model.losas[n].d, e3d.setting.formato_datos))
            tbllosas.Cell(n, 5, Format$(e3d.model.losas[n].alivianado * e3d.model.losas[n].d * e3d.model.losas[n].material.densidad, e3d.setting.formato_datos))
            tbllosas.Cell(n, 6, Format$(e3d.model.losas[n].g, e3d.setting.formato_datos))
            tbllosas.Cell(n, 7, Format$(e3d.model.losas[n].p, e3d.setting.formato_datos))
            tbllosas.Cell(n, 8, "=F" & Str$(n + 1) & "+G" & Str$(n + 1) & "+H" & Str$(n + 1))

        End If
    Next

    tbllosas.Recalcular

End

Public Sub btnAceptar_Click()

    'gurdo los datoos

    Dim n As Integer

    If Message.Question(("Esto eliminara todas las cargas repartidas actuales de losas en los estados ") & gb.Cr & gb.Tab & "2-" &
            ("Gravitatoria") & gb.Cr & gb.tab & "3-" & ("Accidental"), ("Continuar"), ("Cancelar")) = 2 Then Return

        e3d.flags.cambios = True
        For n = 0 To e3d.model.losas.Max

            e3d.model.losas[n].d = tbllosas.CellFloat(n, 4)
            e3d.model.losas[n].g = tbllosas.CellFloat(n, 6)
            e3d.model.losas[n].p = tbllosas.CellFloat(n, 7)

        Next

        Me.Close

        e3d.GenerarPesoPropio(1)
        e3d.RecalcularAreaLosas

        For n = 0 To e3d.model.losas.Max
            FMain.debugInfo("Recargando losa " & Str(n + 1) & " de " & Str(e3d.model.losas.Count),, True)

            e3d.ReLoadElement(n, e3d.tipo_losa, e3d.model.losas[n].g, 2)
            e3d.ReLoadElement(n, e3d.tipo_losa, e3d.model.losas[n].p, 3)
        Next

End

Public Sub btnCopiar_Click()

    Select Case TabStrip1.Index
        Case 0
            tbllosas.CopyToClipboard
        Case 1
            tblEsfuerzos.CopyToClipboard
    End Select

End

Sub llenarEsfuerzos()

    Dim a As Integer

    tblEsfuerzos.rows = e3d.model.losas.Count

    tblEsfuerzos.Columns(0, "Piso",,,, "0")
    tblEsfuerzos.Columns(1, "Nro",,,, "0")
    tblEsfuerzos.Columns(2, "Qx",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(3, "Qz",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(4, "Mx1",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(5, "Mxt",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(6, "Mx2",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(7, "Mz1",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(8, "Mzt",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(9, "Mz2",,, 2, e3d.setting.formato)

    For a = 0 To e3d.model.losas.max

        tblEsfuerzos.Cell(a, 0, e3d.model.losas[a].sector)
        tblEsfuerzos.Cell(a, 1, e3d.model.losas[a].numero)

        tblEsfuerzos.Cell(a, 2, e3d.model.losas[a].maxQx)
        tblEsfuerzos.Cell(a, 3, e3d.model.losas[a].maxQz)
        tblEsfuerzos.Cell(a, 4, e3d.model.losas[a].minMx)
        tblEsfuerzos.Cell(a, 5, e3d.model.losas[a].maxMx)
        tblEsfuerzos.Cell(a, 6, e3d.model.losas[a].minMx)
        tblEsfuerzos.Cell(a, 7, e3d.model.losas[a].minMz)
        tblEsfuerzos.Cell(a, 8, e3d.model.losas[a].maxMz)
        tblEsfuerzos.Cell(a, 9, e3d.model.losas[a].minMz)

    Next
    tblEsfuerzos.Recalcular

End

Public Sub Frame1_MouseDown()

End

Public Sub btnCancel_Click()

    Me.Close

End

Public Sub btnAceptar_Click()

    ' guardo los parametros
    SaveSettings

    Me.close

End

Public Sub Form_Open()

    ' actualizo los datos
    ReadSettings

End

Public Sub TabStrip1_Click()

End

Public Sub rbdMostrarMz_Click()

End

Public Sub ReadSettings()

    valEsfuerzos.Value = modEstru.setting.PasoCalcularEsfuerzos

    'formato de datos
    If modEstru.setting.formato = "0.00" Then
        rdbS2.Value = True
    Else If modEstru.setting.formato = "0.0000" Then
        rdbS4.Value = True
    Else If modEstru.setting.formato = "0.00E00" Then
        rdbScient.Value = True
    Else 'es custom
        rdbSUser.Value = True
        txtSuser.Text = modEstru.setting.formato
    Endif

    If modEstru.setting.formato_datos = "0.00" Then
        rdbE2.Value = True
    Else If modEstru.setting.formato_datos = "0.0000" Then
        rdbE4.Value = True
    Else If modEstru.setting.formato_datos = "0.00E00" Then
        rdbEcient.Value = True
    Else 'es custom
        rdbEUser.Value = True
        txtEuser.Text = modEstru.setting.formato_datos

    Endif

    If modEstru.setting.solver = "1-Gauss" Then
        rbdSolver1.Value = True
    Else If modEstru.setting.solver = "2-MPH" Then
        rbdSolver2.Value = True
    Else If modEstru.setting.solver = "3-Jacobi" Then
        rbdSolver3.Value = True
    Else If modEstru.setting.solver = "4-Banda" Then
        rbdSolver4.Value = True

    Endif

End

Public Sub SaveSettings()

    If rbdSolver1.value Then modEstru.setting.solver = "1-Gauss"
    If rbdSolver2.value Then modEstru.setting.solver = "2-Jacobi"
    If rbdSolver3.value Then modEstru.setting.solver = "3-GSL"
    If rbdSolver4.value Then modEstru.setting.solver = "4-Banda"

    If rdbS2.Value Then modEstru.setting.formato = "0.00"
    If rdbS4.Value Then modEstru.setting.formato = "0.0000"
    If rdbScient.Value Then modEstru.setting.formato = "0.00E00"
    If rdbSuser.Value Then modEstru.setting.formato = txtSuser.Text

    If rdbe2.Value Then modEstru.setting.formato_datos = "0.00"
    If rdbe4.Value Then modEstru.setting.formato_datos = "0.0000"
    If rdbecient.Value Then modEstru.setting.formato_datos = "0.00E00"
    If rdbeuser.Value Then modEstru.setting.formato_datos = txteuser.Text

    modEstru.parametros["Options/ResultsFormat"] = modEstru.setting.formato
    modEstru.parametros["Options/DataFormat"] = modEstru.setting.formato_datos
    modEstru.parametros["Options/Solver"] = modEstru.setting.solver

    modEstru.graficos.colores.N = ColorButton1.Value
    modEstru.graficos.colores.qy = ColorButton2.Value
    modEstru.graficos.colores.qz = ColorButton3.Value
    modEstru.graficos.colores.t = ColorButton4.Value
    modEstru.graficos.colores.my = ColorButton5.Value
    modEstru.graficos.colores.mz = ColorButton6.Value
    modEstru.graficos.colores.elastica = ColorButton7.Value
    modEstru.graficos.colores.tension = ColorButton8.Value

    modEstru.setting.PasoCalcularEsfuerzos = valEsfuerzos.Value

    If rbdMostrarMz.Value Then modEstru.flags.MostrarDespuesCalculo = 1  ' despues de calcula, muestro momentos Mz
    ' TODO completar el resto
    If chkOcultar.Value Then modEstru.flags.OcultarCargas = 1  ' cuando muestra, oculta cargas

End

Public Sub valEsfuerzos_Change()

    modEstru.flags.calculado = False

End

Public Sub valElastica_Change()

    modEstru.flags.calculado = False

End

Public Sub ValueBox3_Change()

    modEstru.flags.calculado = False

End

Public Sub ValueBox4_Change()

    modEstru.flags.calculado = False

End

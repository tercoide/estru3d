Public SeEliminaran As Integer
Public nudosAgregados As Integer

Public Sub Form_Open()

    'pone los titulos a la regilla (nota: es tu tableview para permitir editar los datos)

    Me.Title = ("Editor de model.nudos")
    DefinirgrdEditorNodos()

    'cargar datos..
    '

    'centro el formulario en pantalla
    Me.Center()
    llenar_tabla

End

Public Sub DefinirgrdEditorNodos()

    grdEditorNodos.header = GridView.Horizontal
    grdEditorNodos.rows.count = 0
    grdEditorNodos.columns.count = 4

    grdEditorNodos.Columns[0].title = ("Nudo")
    grdEditorNodos.Columns[1].title = "X"
    grdEditorNodos.Columns[2].title = "Y"
    grdEditorNodos.Columns[3].title = "Z"
    '.Columns[4].title = ("Grupo")  'reservado para uso futuro

    grdEditorNodos.Columns[0].width = 40
    grdEditorNodos.Columns[1].width = 120
    grdEditorNodos.Columns[2].width = 120
    grdEditorNodos.Columns[3].width = 120
    '.Columns[4].width = 40

    grdEditorNodos.Columns[0].Alignment = Align.Center
    grdEditorNodos.Columns[1].Alignment = Align.Right
    grdEditorNodos.Columns[2].Alignment = Align.Right
    grdEditorNodos.Columns[3].Alignment = Align.Right
    '.Columns[4].Alignment = Align.Right
    '.font.name = "Times"
    '.font.size = 9
    '.Background = 16777215
    '.Foreground = 0

End

Public Sub btnAdd_Click()

    ' agrego un model.nudo
    Dim ok As Integer

    ' innecesario
    model.nudosAgregados += 1

    'ok = e3d.AddNudo(0, 0, 0, False)

    grdEditorNodos.Rows.Count += 1

    If grdEditorNodos.Rows.Count > 1 Then grdEditorNodos[grdEditorNodos.Rows.Max, 0].Text = CInt(grdEditorNodos[grdEditorNodos.Rows.Max - 1, 0].Text) + 1 Else grdEditorNodos[grdEditorNodos.Rows.Max, 0].text = "1"
    grdEditorNodos.Row = grdEditorNodos.Rows.max
    grdEditorNodos.Column = 1
    grdEditorNodos.Edit

    'innecesario
    'llenar_tabla

End

Public Sub btnRemove_Click()

    ' elimino el model.nudo

    ' veo que model.nudo es
    Dim n As Integer, a As Integer, ultimo As Integer

    If grdEditorNodos.Row < 0 Then Return
    n = CInt(grdEditorNodos[grdEditorNodos.Row, 0].Text)

    'cancelo la edicion
    grdEditorNodos.Cancel
    grdEditorNodos.Rows.Remove(grdEditorNodos.Row)
    ' primero verifico que el model.nudo a eliminar no este entre lo agregados
    If n <= e3d.model.nudo.Count Then
        'marco el model.nudo para futura eliminación
        e3d.model.nudo_seleccionado[n] = True

        SeEliminaran = True
        'grdEditorNodos[grdEditorNodos.row, 0].Background = Color.Gray

    Else
        'elimino un model.nudo AGEGADO y que todavia no esta en el array de model.nudos, simplemente renombro la primer fila
        'a partir del ultimo nodo REAL
        model.nudosAgregados -= 1
        ' esto previene clicks histericos
        If grdEditorNodos.row < 0 Then Return 'porque elimino la ultima

        If grdEditorNodos.Rows.Count = 1 Then ' me queda un solo model.nudo
            grdEditorNodos[0, 0].Text = "1"
        Else If grdEditorNodos.Rows.Count > 1 Then
            ultimo = e3d.model.nudo.count
            If grdEditorNodos.row > 0 Then ultimo = CInt(grdEditorNodos[grdEditorNodos.row - 1, 0].Text)
            For a = 0 To grdEditorNodos.Rows.Max
                If CInt(grdEditorNodos[a, 0].Text) > ultimo Then
                    ultimo += 1
                    grdEditorNodos[a, 0].Text = ultimo
                End If
            Next
        End If
    End If

End

Public Sub btnOK_Click()

    'salir del formulario, aceptando cambios
    'aceptar

    Dim a As Integer, pos As Integer, n As Integer, b As Integer
    Dim hPos As String
    ' primero guardo lo que estaba editando

    If SeEliminaran Then
        a = Message.Warning(("Esta a punto de eliminar model.nudos. Se eliminaran las cargas y apoyos del model.nudo, ademas las barras que utilicen el model.nudo tendran un model.nudo no valido"), ("Aceptar"), ("Cancelar"))
        If a = 2 Then Return
    End If

    ' ahora reescribo los nuevos parametros de los model.nudos existentes
    For a = 0 To grdEditorNodos.Rows.max
        'prevengo errores de null en el caso que el usuario haya dejado las celdas vacias
        For b = 1 To 3
            If IsNull(grdEditorNodos[a, b].Text) Then grdEditorNodos[a, b].Text = "0"
        Next

        pos = CInt(grdEditorNodos[a, 0].Text)   '2020 ahora esto es el handle
        If pos > e3d.model.nudo.count Then Break
        hPos = e3d.GetNodeHandle(pos)
        If hPos = "" Then Break
        e3d.model.nudo[hpos].x = Val(grdEditorNodos[a, 1].Text)
        e3d.model.nudo[hpos].Y = Val(grdEditorNodos[a, 2].Text)
        e3d.model.nudo[hpos].z = Val(grdEditorNodos[a, 3].Text)
    Next

    'guardo este valor
    n = e3d.model.nudo.count

    ' agrego los model.nudos
    For a = 1 To model.nudosAgregados
        hpos = e3d.AddNudo(0, 0, 0, False)
    Next

    ' ahora reescribo los nuevos parametros de los model.nudos nuevos
    For a = 0 To grdEditorNodos.Rows.max
        'prevengo errores de null en el caso que el usuario haya dejado las celdas vacias
        For b = 1 To 3
            If IsNull(grdEditorNodos[a, b].Text) Then grdEditorNodos[a, b].Text = "0"
        Next

        pos = CInt(grdEditorNodos[a, 0].Text)
        If pos > n Then 'es un model.nudo de los nuevos
            Inc n
            hPos =
                e3d.model.nudo[n].x = Val(grdEditorNodos[a, 1].Text)
            e3d.model.nudo[n].Y = Val(grdEditorNodos[a, 2].Text)
            e3d.model.nudo[n].z = Val(grdEditorNodos[a, 3].Text)
        End If
    Next

    ' TODO: 2025 verificar
    ' ' elimino los model.nudos borrados
    ' For a = e3d.model.nudo.count To 1 Step -1
    '     'If a > e3d.model.nudo.max Then Break  'esto previene que "a" se pase cuando el total de model.nudos disminuye
    '     If e3d.model.nudo_seleccionado[a] = True Then
    '         e3d.EliminarNudo(a)
    '         'a -= 1  'esto previene que se saltee el model.nudo siguiente, si es que deberia eliminarse también
    '     End If
    ' Next
    ' e3d.ReIndexNodes()

    Me.Close

End

Public Sub btnCancel_Click()

    Dim a As Integer
    'salir del formulario, sin aceptar cambios
    ' deselecciono
    For Each n As Clsnudo In e3d.model.nudo

        n.Selected = False

    Next

    FMain.SetStatus
    fmain.debuginfo(("Cerrando Tabla de model.nudos"))
    Me.close

End

Private Sub llenar_tabla()

    Dim a As Integer, b As Integer
    Dim n As ClsNudo

    grdEditorNodos.Rows.Count = e3d.model.nudo.count
    For Each n In e3d.model.nudo
        Inc a
        grdEditorNodos[a - 1, 0].Text = CStr(n.indice) ' Str$(a)
        If n.Loose Then
            grdEditorNodos[a - 1, 0].Background = Color.Merge(Color.LightGray, Color.red)
        Else
            grdEditorNodos[a - 1, 0].Background = Color.LightGray
        End If
        grdEditorNodos[a - 1, 1].Text = Format$(n.x, e3d.setting.formato_datos)
        grdEditorNodos[a - 1, 2].Text = Format$(n.Y, e3d.setting.formato_datos)
        grdEditorNodos[a - 1, 3].Text = Format$(n.z, e3d.setting.formato_datos)

        n.Selected = False
    Next

End Sub

Public Sub Form_Activate()

    e3d.ReIndexNodes()

    fmain.debuginfo(("Abriendo Tabla de model.nudos"))

End

Public Sub grdEditorNodos_Click()

    If grdEditorNodos.Column < 4 And grdEditorNodos.Column > 0 Then
        grdEditorNodos.Edit
    End If

End

Public Sub grdEditorNodos_Save(f As Integer, c As Integer, v As String)

    Try grdEditorNodos[f, c].Text = Format$(Eval(v), e3d.setting.formato_datos)

    If f = grdEditorNodos.Rows.max And c = 3 Then
        'agrego un model.nudo mas
        btnAdd_Click
        '   Else
        '      ' simplemente guardo
        '      grdEditorNodos.row += 1
    End If

End

' Gambas class file

Public Sub Form_Open()

    ' lleno las tablas

    Dim a As Integer

    tblVigas.rows = e3d.model.vigas.Count ' ponele

    tblVigas.cols = 8

    tblVigas.Header = GridView.Both

    '

    tblEsfuerzos.rows = e3d.model.vigas.Count
    tblEsfuerzos.cols = 13

    llenartabla
    llenarEsfuerzos

End

Public Sub btnCancelar_Click()

    Me.Close(0)

End

Sub llenartabla()

    Dim n As Integer, v As ClsViga

    tblVigas.rows = e3d.model.vigas.Count
    tblVigas.Columns(0, "Piso",,, 3, "0")
    tblVigas.Columns(1, "Nro",,, 3, "0")
    tblVigas.Columns(2, "Largo",,, 2, "0.00")
    tblVigas.Columns(3, "Nudo i",,, 3, "0")
    tblVigas.Columns(4, "Nudo f",,, 3, "0")
    tblVigas.Columns(5, "Ancho",,, 2, "0.00")
    tblVigas.Columns(6, "Alto",,, 2, "0.00")
    tblVigas.Columns(7, "Carga q",,, 2, "0.00")

    For Each v In e3d.model.vigas

        tblVigas.Cell(n, 0, v.piso)
        tblVigas.Cell(n, 1, v.numero)
        tblVigas.Cell(n, 2, modAlgebra.Distancia(e3d.model.nudo[v.nudo1].xyz, e3d.model.nudo[v.nudo2].xyz))
        tblVigas.Cell(n, 3, v.nudo1)
        tblVigas.Cell(n, 4, v.nudo2)
        tblVigas.Cell(n, 5, v.seccion.a)
        tblVigas.Cell(n, 6, v.seccion.b)
        tblVigas.Cell(n, 7, v.g)
        Inc n
    Next

    tblVigas.Recalcular

End

Sub llenarEsfuerzos()

    Dim a As Integer, v As ClsViga

    tblEsfuerzos.Columns(0, "Piso",,,, "0")
    tblEsfuerzos.Columns(1, "Nro",,,, "0")
    tblEsfuerzos.Columns(2, "N+",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(3, "N-",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(4, "Q+",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(5, "Q-",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(6, "M+",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(7, "M-",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(8, "Qi",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(9, "Q2",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(10, "Mi",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(11, "Mt",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(12, "M2",,, 2, e3d.setting.formato)

    For Each v In e3d.model.vigas

        tblEsfuerzos.Cell(a, 0, v.piso)
        tblEsfuerzos.Cell(a, 1, v.numero)

        tblEsfuerzos.Cell(a, 2, v.maxN)
        tblEsfuerzos.Cell(a, 3, v.minN)
        tblEsfuerzos.Cell(a, 4, v.maxQy)
        tblEsfuerzos.Cell(a, 5, v.minQy)
        tblEsfuerzos.Cell(a, 6, v.maxMz)
        tblEsfuerzos.Cell(a, 7, v.minMz)
        tblEsfuerzos.Cell(a, 8, v.niQy)
        tblEsfuerzos.Cell(a, 9, v.nfQy)
        tblEsfuerzos.Cell(a, 10, v.niMz)
        tblEsfuerzos.Cell(a, 11, v.maxMz)
        tblEsfuerzos.Cell(a, 12, v.nfMz)
        Inc a

    Next
    tblEsfuerzos.Recalcular

End

Public Sub btnCopiar_Click()

    Select Case TabStrip1.Index
        Case 0
            tblVigas.CopyToClipboard
        Case 1
            tblEsfuerzos.CopyToClipboard
    End Select

End

Public Sub btnAceptar_Click()

    ' Aplico los cambios

    Dim n As Integer
    Dim b As Integer, v As ClsViga

    If Message.Question(("Esto reemplazara todas las cargas de las vigas ") & gb.Cr & gb.Tab & "1-" &
            ("Peso propio") & gb.Cr & gb.tab & "2-" & ("Permanente"), ("Continuar"), ("Cancelar")) = 2 Then Return

        e3d.flags.cambios = True
        For Each v In e3d.model.vigas

            v.g = tblVigas.CellFloat(n, 7)

        Next

        Me.Close

        e3d.GenerarPesoPropio(1)

        For Each v In e3d.model.vigas
            FMain.debugInfo("Recargando viga " & Str(n + 1) & " de " & Str(e3d.model.vigas.Count),, True)
            e3d.ReLoadViga(v, v.g, 2)

        Next

End

Public Sub btnSeccion_Click()

    Dim a As Integer, s As Integer

    e3d.flags.seccion = True
    formtablasecc.ShowModal
    If e3d.flags.seccion <= 0 Then Return

    'veo si esta bien seleccionada la viga
    For a = tblVigas.SelRow To tblVigas.SelRow + tblVigas.SelRows - 1
        e3d.model.vigas[a].seccion = e3d.flags.seccion

        'ahora tengo que hacer que todas las barras que pertenecena la viga, cambien la seccion

        For s = 1 To e3d.model.barra.Max
            If (e3d.model.barra[s].grupo = e3d.model.vigas[a].numero) And (e3d.model.barra[s].sector = e3d.model.vigas[a].sector) And (e3d.model.barra[s].tipo = e3d.tipo_viga) Then
                e3d.model.barra[s].seccion = e3d.flags.seccion
            End If

        Next

    Next

    llenartabla

End

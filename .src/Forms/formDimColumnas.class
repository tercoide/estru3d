' Gambas class file

Public tblTexto As String
Public tblTextoAnterior As String
Public editando As Boolean
Public tblRow As Integer
Public tblCol As Integer
Public TotalColumnas As Integer

Public Sub Form_Open()

    tblColumnas.rows = e3d.model.columna.Count

    tblColumnas.cols = 8

    tblColumnas.Header = GridView.Both

    '

    tblEsfuerzos.rows = TotalColumnas
    tblEsfuerzos.cols = 7

    llenartabla
    If e3d.flags.calculado Then llenarEsfuerzos

End

Public Sub btnSalir_Click()

    Me.Close(0)

End

Sub llenartabla()

    Dim n As Integer
    Dim a As Integer
    Dim c As ClsColumna

    tblColumnas.Columns(0, "Piso",,, 3, "0")
    tblColumnas.Columns(1, "Nro",,, 3, "0")
    tblColumnas.Columns(2, "Alto",,, 2, "0.00")
    tblColumnas.Columns(3, "Nudo i",,, 3, "0")
    tblColumnas.Columns(4, "Nudo f",,, 3, "0")
    tblColumnas.Columns(5, "Ax",,, 2, "0.00")
    tblColumnas.Columns(6, "Az",,, 2, "0.00")

    For Each c In e3d.model.columna

        tblColumnas.Cell(n, 0, c.sector)
        tblColumnas.Cell(n, 1, c.numero)
        tblColumnas.Cell(n, 2, modAlgebra.Distancia(e3d.model.nudo[c.nudo1].xyz, e3d.model.nudo[c.nudo2].xyz))
        tblColumnas.Cell(n, 3, c.nudo1)
        tblColumnas.Cell(n, 4, c.nudo2)
        tblColumnas.Cell(n, 5, c.seccion.a)
        tblColumnas.Cell(n, 6, c.seccion.b)
        Inc n

    Next

    tblColumnas.Recalcular

End

Sub llenarEsfuerzos()

    Dim a As Integer, n As Integer

    tblEsfuerzos.Columns(0, "Piso",,,, "0")
    tblEsfuerzos.Columns(1, "Nro",,,, "0")
    tblEsfuerzos.Columns(2, "N",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(3, "My1",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(4, "My2",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(5, "Mz1",,, 2, e3d.setting.formato)
    tblEsfuerzos.Columns(6, "Mz2",,, 2, e3d.setting.formato)

    For Each b As ClsBarra In e3d.model.barra

        If b.tipo = e3d.tipo_columna Then

            tblEsfuerzos.Cell(n, 0, b.sector)
            tblEsfuerzos.Cell(n, 1, b.grupo)

            tblEsfuerzos.Cell(n, 2, b.EsfExtBar.minN)
            tblEsfuerzos.Cell(n, 3, b.EsfExtBar.NiMy)
            tblEsfuerzos.Cell(n, 4, b.EsfExtBar.NfMy)
            tblEsfuerzos.Cell(n, 5, b.EsfExtBar.NiMz)
            tblEsfuerzos.Cell(n, 6, b.EsfExtBar.NfMz)
            Inc n

        End If

    Next
    tblEsfuerzos.Recalcular

End

Public Sub btnCopiar_Click()

    Select Case TabStrip1.Index
        Case 0
            tblColumnas.CopyToClipboard
        Case 1
            tblEsfuerzos.CopyToClipboard
    End Select

End

Public Sub btnEliminar_Click()

End
